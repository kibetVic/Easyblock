@model SACCOBlockChainSystem.Models.Appraisal

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">Loan Appraisal Details</h5>
    </div>
    <div class="card-body">
        @if (Model != null)
        {
            <div class="row">
                <div class="col-md-6">
                    <h6 class="text-muted mb-3">Appraisal Information</h6>
                    <div class="info-row">
                        <span class="text-muted">Appraisal Date:</span>
                        <span>@(Model.AppraisDate?.ToString("dd MMM yyyy HH:mm") ?? "N/A")</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Appraised By:</span>
                        <span>@Model.OfficerNames</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Member No:</span>
                        <span>@Model.MemberNo</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Transaction No:</span>
                        <span>@Model.TransactionNo</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <h6 class="text-muted mb-3">Recommended Amount</h6>
                    <div class="info-row">
                        <span class="text-muted">Recommended Amount:</span>
                        <span class="fw-bold text-primary">KES @(Model.AmtRecommended?.ToString("N2") ?? "0.00")</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Interest Rate:</span>
                        <span>@(Model.Interest?.ToString("N2") ?? "0")%</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Total Interest:</span>
                        <span>KES @(Model.TotalInterest?.ToString("N2") ?? "0.00")</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Principal:</span>
                        <span>KES @(Model.Principal?.ToString("N2") ?? "0.00")</span>
                    </div>
                </div>
            </div>

            <hr>

            <div class="row mt-3">
                <div class="col-md-6">
                    <h6 class="text-muted mb-3">Member Financial Position</h6>
                    <div class="info-row">
                        <span class="text-muted">Salary:</span>
                        <span>KES @(Model.Salary?.ToString("N2") ?? "0.00")</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Allowances:</span>
                        <span>KES @(Model.Allowances?.ToString("N2") ?? "0.00")</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Net Monthly Salary:</span>
                        <span>KES @(Model.NetMonthlySalary?.ToString("N2") ?? "0.00")</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Expected Net Salary:</span>
                        <span>KES @Model.ExpectedNetSalary.ToString("N2")</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Shares Value:</span>
                        <span>KES @(Model.Shares?.ToString("N2") ?? "0.00")</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Co-op Shares:</span>
                        <span>KES @(Model.CoopShares?.ToString("N2") ?? "0.00")</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <h6 class="text-muted mb-3">Existing Obligations</h6>
                    <div class="info-row">
                        <span class="text-muted">Existing Loans:</span>
                        <span>KES @(Model.Loans?.ToString("N2") ?? "0.00")</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Co-op Loans:</span>
                        <span>KES @(Model.CoopLoans?.ToString("N2") ?? "0.00")</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Bank Loan:</span>
                        <span>KES @(Model.BankLoan?.ToString("N2") ?? "0.00")</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Deductions:</span>
                        <span>KES @(Model.Deductions?.ToString("N2") ?? "0.00")</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Total Deductions:</span>
                        <span>KES @Model.TotalDeductions.ToString("N2")</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Society Payment:</span>
                        <span>KES @(Model.SocietyPayment?.ToString("N2") ?? "0.00")</span>
                    </div>
                </div>
            </div>

            <hr>

            <div class="row mt-3">
                <div class="col-md-6">
                    <h6 class="text-muted mb-3">Repayment Information</h6>
                    <div class="info-row">
                        <span class="text-muted">Repay Method:</span>
                        <span>@Model.RepayMethod</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Repay Rate:</span>
                        <span>KES @(Model.RepayRate?.ToString("N2") ?? "0.00")</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">No of Loans:</span>
                        <span>@(Model.NoOfLoans?.ToString() ?? "0")</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Loan Guarantor:</span>
                        <span>KES @(Model.LoanGuarantor?.ToString("N2") ?? "0.00")</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <h6 class="text-muted mb-3">Deduction Ratios</h6>
                    <div class="info-row">
                        <span class="text-muted">Deduction to Gross:</span>
                        <span>@Model.DeductionToGross.ToString("N2")%</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Total Ded New Loan to Gross:</span>
                        <span>@Model.TotalDedNewLoanToGross.ToString("N2")%</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Net Salary to Gross:</span>
                        <span>@Model.NetSalaryToGross.ToString("N2")%</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Total Loan to Gross:</span>
                        <span>@Model.TotalLoanToGross.ToString("N2")%</span>
                    </div>
                    <div class="info-row">
                        <span class="text-muted">Total Coop Ded to Gross:</span>
                        <span>@Model.TotalCoopDedToGross.ToString("N2")%</span>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Reason))
            {
                <div class="mt-3">
                    <h6 class="text-muted mb-2">Appraisal Notes / Reason</h6>
                    <div class="bg-light p-3 rounded">
                        @Model.Reason
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.BlockchainTxId))
            {
                <div class="mt-3 p-3 bg-success bg-opacity-10 rounded">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-shield-check fs-4 text-success me-3"></i>
                        <div>
                            <strong class="text-success">Blockchain Verified</strong>
                            <p class="text-muted small mb-0">Transaction ID: @Model.BlockchainTxId</p>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-clipboard-data fs-1 text-muted"></i>
                <p class="text-muted mt-3">No appraisal has been conducted yet</p>
            </div>
        }
    </div>
</div>

<style>
    .info-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid #f0f0f0;
    }

        .info-row:last-child {
            border-bottom: none;
        }
</style>