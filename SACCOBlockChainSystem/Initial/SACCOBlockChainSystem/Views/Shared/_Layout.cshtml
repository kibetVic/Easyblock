                                        @{
                                            //var userRole = User.FindFirstValue(ClaimTypes.Role);
                                            var isBookKeeper = userRole == "Book Keeper";
                                        }
                                        @if (!isBookKeeper)
                                        {
                                            <li class="nav-item">
                                                <a asp-controller="LoanMvc" asp-action="PendingDisbursement" class="nav-link">
                                                    <i class="nav-icon bi bi-cash-stack"></i>
                                                    <p>Disbursement</p>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </li>

