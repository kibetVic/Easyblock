                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Account" asp-action="UserManagement">
                                            <i class="bi bi-people"></i> User Management
                                        </a>
                                    </li>
                                }

                                <!-- For Super Admin, Admin, and System Administrator only -->
                                @{
                                    var userRole = User.FindFirstValue(ClaimTypes.Role);
                                    var userGroup = User.FindFirstValue("UserGroup");
                                    var canManageUsers = userRole == "Super Admin" ||
                                    userRole == "Admin" ||
                                    userRole == "System Administrator" ||
                                    userGroup == "Super Admin" ||
                                    userGroup == "Admin" ||
                                    userGroup == "System Administrator";
                                }

                                @if (canManageUsers)
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Account" asp-action="CompanySwitch">
                                            <i class="bi bi-arrow-left-right"></i> Switch Company
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>

                        <!-- MEMBER MANAGEMENT / RECORDS -->
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon bi bi-people-fill"></i>
                                <p>
