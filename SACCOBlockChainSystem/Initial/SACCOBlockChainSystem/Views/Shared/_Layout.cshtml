                                <i class="nav-icon bi bi-bar-chart-fill"></i>
                                <p>
                                    <b>Reports</b>
                                    <i class="nav-arrow bi bi-chevron-right float-end"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview ms-2 border-start border-primary border-opacity-25 ps-2">
                                <!-- Loan Reports -->
                                <li class="nav-item">
                                    <a asp-controller="LoanReport" asp-action="LoansPerSacco" class="nav-link">
                                        <i class="nav-icon bi bi-file-earmark-diff"></i>
