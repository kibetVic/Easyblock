<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EasySacco </title>

    <link rel="stylesheet" href="~/AdminLte/dist/css/adminlte.css" />
    <!-- Radzen CSS - Make sure these come after Bootstrap -->
    <link rel="stylesheet" href="/blazorcss/material-base.css" />
    <link rel="stylesheet" href="/blazorcss/standard-base.css" />
    <link rel="stylesheet" href="/blazorcss/standard.css" />
    <link href="~/css/member.css" rel="stylesheet" />

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Font Awesome for icons <link rel="stylesheet" href="~/css/bootstrap-icons.css" asp-append-version="true" />

    @* <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"> *@

    <!-- Bootstrap for styling -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    @* <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script> *@
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

    <!--begin::Fonts-->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/@@fontsource/source-sans-3@5.0.12/index.css"
          integrity="sha256-tXJfXfp6Ewt1ilPzLDtQnJV4hclT9XuaZUKyUvmyr+Q="
          crossorigin="anonymous"
          media="print"
          onload="this.media='all'" />
    <!--begin::Third Party Plugin(OverlayScrollbars)-->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/styles/overlayscrollbars.min.css"
          crossorigin="anonymous" />
    <!--end::Third Party Plugin(OverlayScrollbars)-->
    <!--begin::Third Party Plugin(Bootstrap Icons)-->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
          crossorigin="anonymous" />
    <!--end::Third Party Plugin(Bootstrap Icons)-->
    <!-- apexcharts -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/apexcharts@3.37.1/dist/apexcharts.css"
          integrity="sha256-4MX+61mt9NVvvuPjUWdUdyfZfxSB1/Rf9WtqRHgG5S0="
          crossorigin="anonymous" />
    <!-- jsvectormap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/jsvectormap@1.5.3/dist/css/jsvectormap.min.css"
          integrity="sha256-+uGLJmmTKOqBr+2E6KDYs/NRsHxSkONXFHUL0fy2O/4="
          crossorigin="anonymous" />

    @RenderSection("Styles", required: false)

</head>
<body class="layout-fixed sidebar-expand-lg sidebar-open bg-body-tertiary">
    <div class="app-wrapper">
        <!--begin::Header-->
        <!--begin::Header-->
        <nav class="app-header navbar navbar-expand bg-body">
            <!--begin::Container-->
            <div class="container-fluid">
                <!--begin::Start Navbar Links-->
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button">
                            <i class="bi bi-list"></i>
                        </a>
                    </li>

                    <li class="nav-item">
                        @using System.Security.Claims
                        @if (User.Identity.IsAuthenticated)
                        {
                            var userGroupClaim = User.FindFirstValue(ClaimTypes.Role);
                            var isSuperAdmin = userGroupClaim == "Super Admin" || userGroupClaim == "SuperAdmin";

                            <div class="company-info">
                                <small>
                                    @if (isSuperAdmin)
                                    {
                                        <strong>All System SACCOs</strong>
                                    }
                                    else
                                    {
                                        <strong>@User.FindFirstValue("CompanyName")</strong>
                                    }
                                </small>
                            </div>
                        }
                    </li>

                    @* <li class="nav-item">
                        @using System.Security.Claims
                        @if (User.Identity.IsAuthenticated)
                        {
                            <div class="company-info">
                                <small>
                                    <strong>@User.FindFirstValue("CompanyName")</strong>
                                </small>
                            </div>
                        }
                    </li> *@
                </ul>
                <!--end::Start Navbar Links-->
                <!--begin::End Navbar Links-->
                <ul class="navbar-nav ms-auto">
                    <!--begin::Fullscreen Toggle-->
                    <li class="nav-item">
                        <a class="nav-link" href="#" data-lte-toggle="fullscreen">
                            <i data-lte-icon="maximize" class="bi bi-arrows-fullscreen"></i>
                            <i data-lte-icon="minimize" class="bi bi-fullscreen-exit" style="display: none"></i>
                        </a>
                    </li>
                    <!--end::Fullscreen Toggle-->
                    <!--begin::User Menu Dropdown-->
                    <!--begin::User Menu Dropdown-->
                    <li class="nav-item dropdown user-menu">
                        <div class="collapse navbar-collapse" id="navbarNav">
                            <ul class="navbar-nav ms-auto">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                                            <i class="fas fa-user-circle me-1"></i>
                                            @{
                                                // Show username instead of role
                                                var userName = User.Identity?.Name;
                                            }
                                            @userName
                                        </a>
                                        <ul class="dropdown-menu">

                                            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("Super Admin"))
                                            {
                                                <li><hr class="dropdown-divider m-0"></li>
                                                <li><a class="dropdown-item" href="/Admin/Dashboard"><i class="fas fa-tachometer-alt me-2"></i>Admin Panel</a></li>
                                            }

                                            @* <li><hr class="dropdown-divider m-0"></li> *@
                                            <li>
                                                <form method="post" asp-controller="Account" asp-action="LogoutPost">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item">
                                                        <i class="fas fa-sign-out-alt me-2"></i>Logout
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </li>
                                }
                                else
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" href="/Account/Login">
                                            <i class="fas fa-sign-in-alt me-1"></i>Login
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" href="/Account/Signup">
                                            <i class="fas fa-user-plus me-1"></i>Register
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </li>
                    <!--end::User Menu Dropdown-->
                </ul>
                <!--end::End Navbar Links-->
            </div>
            <!--end::Container-->
        </nav>
        
        <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="blue">
            <!--begin::Sidebar Brand-->
            <div class="sidebar-brand">
                <!--begin::Brand Link-->
                <a asp-controller="Home" asp-action="Index" class="brand-link">
                    <!--begin::Brand Image-->
                    <!-- Show only the role/user group -->
                    <li>
                        <div class="dropdown-item-text">
                            <i class="fas fa-user-tag me-2"></i>
                            <strong class="brand-text fw-bold fs-5">
                                @{
                                    // Debug: Check available claims
                                    var userGroupClaim = User.FindFirst("UserGroup")?.Value;
                                    var roleClaim = User.FindFirst(ClaimTypes.Role)?.Value;
                                    var userName = User.Identity?.Name;

                                    if (!string.IsNullOrEmpty(userGroupClaim))
                                    {
                                        @userGroupClaim
                                    }
                                    else if (!string.IsNullOrEmpty(roleClaim))
                                    {
                                        @roleClaim
                                    }
                                    else
                                    {
                                        @userName
                                    }
                                }
                            </strong>
                        </div>
                    </li>
                    <!--end::Brand Text-->
                </a>
                <!--end::Brand Link-->
            </div>
            <!--end::Sidebar Brand-->
            <div class="sidebar-wrapper">
                <!-- Sidebar Menu -->
                <nav class="mt-2">
                    <ul class="nav sidebar-menu flex-column"
                        data-lte-toggle="treeview"
                        role="navigation"
                        aria-label="Main navigation"
                        data-accordion="false"
                        id="navigation">

                        <!-- DASHBOARD -->
