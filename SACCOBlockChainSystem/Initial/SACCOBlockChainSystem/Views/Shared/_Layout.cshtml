    <script>
        // Function to get page icon based on controller/action
        function getPageIcon() {
            const controller = '@ViewContext.RouteData.Values["Controller"]';
            const action = '@ViewContext.RouteData.Values["Action"]';

            if (controller === 'Home') return 'fa-tachometer-alt';
            if (controller === 'Member') return 'fa-users';
            if (controller === 'TransactionsMvc') {
                if (action === 'Deposit') return 'fa-money-bill-wave';
                if (action === 'Withdraw') return 'fa-hand-holding-usd';
                if (action === 'History') return 'fa-history';
                if (action === 'Balance') return 'fa-balance-scale';
            }
            if (controller === 'Loan') return 'fa-file-contract';
            if (controller === 'Share') return 'fa-chart-line';
            if (controller === 'Blockchain') return 'fa-link';
            if (controller === 'Reports') return 'fa-chart-bar';
            if (controller === 'Admin') return 'fa-cogs';
            return 'fa-file';
        }

        // Update page title icon
        document.addEventListener('DOMContentLoaded', function() {
            const pageIcon = document.querySelector('.page-title i');
            if (pageIcon) {
                pageIcon.className = 'fas ' + getPageIcon() + ' me-2';
            }

            // Load blockchain stats
            loadBlockchainStats();
            setInterval(loadBlockchainStats, 30000); // Update every 30 seconds
        });

        function loadBlockchainStats() {
            // Fetch blockchain status
            fetch('/api/Blockchain/Status')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('blockchainStatus').textContent = data.status;
                        document.getElementById('transactionCount').textContent = data.totalTransactions;
                        document.getElementById('lastSyncTime').textContent = new Date(data.lastSync).toLocaleTimeString();

                        // Update pending loans count for admin
                        if (data.pendingLoans) {
                            document.getElementById('pendingLoansCount').textContent = data.pendingLoans;
                        }
                    }
                })
                .catch(error => {
                    console.error('Error loading blockchain stats:', error);
                });
        }
                  



                function updateLoanWorkflowCounts() {
                    var companyCode = '@User.FindFirst("CompanyCode")?.Value';

                    $.ajax({
                        url: '@Url.Action("GetWorkflowCounts", "LoanMvc")',
                        type: 'GET',
                        data: { companyCode: companyCode },
                        success: function (response) {
                            if (response.success) {
                                $('#underAppraisalCount').text(response.data.underAppraisal || 0);
                                $('#pendingApprovalCount').text(response.data.pendingApproval || 0);
                                $('#pendingDisbursementCount').text(response.data.approvedPendingDisbursement || 0);
                            } else {
                                console.error('API returned success false:', response);
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error('AJAX Error:', {
                                status: status,
                                error: error,
                                response: xhr.responseText
                            });
                        }
                    });
                }


                $(document).ready(function () {
                    updateLoanWorkflowCounts();
               
                    setInterval(updateLoanWorkflowCounts, 60000);
                });


             $(document).ready(function() {
            // Initialize menu collapse/expand - FIXED VERSION
            // Target parent nav-items that have nested treeviews
            $('.nav-sidebar .nav-item:has(.nav-treeview) > .nav-link').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();

                const $this = $(this);
                const $parentItem = $this.closest('.nav-item');
                const $treeview = $parentItem.find('.nav-treeview').first();
                const isOpen = $parentItem.hasClass('menu-open');

                // Close all other menus at the same level (accordion behavior)
                $parentItem.siblings('.nav-item.menu-open').each(function() {
                    $(this).removeClass('menu-open');
                    $(this).find('.nav-treeview').slideUp(200);
                });

                // Toggle current menu
                if (isOpen) {
                    $parentItem.removeClass('menu-open');
                    $treeview.slideUp(200);
                } else {
                    $parentItem.addClass('menu-open');
                    $treeview.slideDown(200);
                }
            });

            // Also handle nested treeview items (like Loan Application inside Transactions)
            $('.nav-treeview .nav-item:has(.nav-treeview) > .nav-link').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();

                const $this = $(this);
                const $parentItem = $this.closest('.nav-item');
                const $treeview = $parentItem.find('.nav-treeview').first();
                const isOpen = $parentItem.hasClass('menu-open');

                // Toggle nested menu
                if (isOpen) {
                    $parentItem.removeClass('menu-open');
                    $treeview.slideUp(200);
                } else {
                    $parentItem.addClass('menu-open');
                    $treeview.slideDown(200);
                }
            });

            // Prevent clicks on actual action links from triggering treeview toggle
            $('.nav-treeview .nav-link[href!="#"]').on('click', function(e) {
                e.stopPropagation();
            });

            // Highlight active menu item
            function highlightActiveMenu() {
                const currentUrl = window.location.pathname.toLowerCase();

                // Remove all active classes
                $('.nav-link').removeClass('active');

                // Don't auto-open all menus - just highlight active link
                $('.nav-link').each(function() {
                    const $this = $(this);
                    const href = $this.attr('href');

                    if (href && href !== '#' && href !== '/' && href !== '') {
                        // Clean up href for comparison
                        let cleanHref = href.toLowerCase().split('?')[0].split('#')[0];
                        let cleanCurrent = currentUrl.split('?')[0].split('#')[0];

                        if (cleanCurrent === cleanHref ||
                            (cleanCurrent !== '/' && cleanHref !== '/' && cleanCurrent.includes(cleanHref))) {

                            $this.addClass('active');

                            // Open parent menus without animation on page load
                            const $parentNavItem = $this.closest('.nav-item');
                            const $parentTreeview = $this.closest('.nav-treeview');

                            if ($parentTreeview.length) {
                                const $parentMenuItem = $parentTreeview.closest('.nav-item');
                                $parentMenuItem.addClass('menu-open');
                                $parentTreeview.show();

                                // Also open grandparent if needed
                                const $grandParentTreeview = $parentMenuItem.closest('.nav-treeview');
                                if ($grandParentTreeview.length) {
                                    $grandParentTreeview.closest('.nav-item').addClass('menu-open');
                                    $grandParentTreeview.show();
                                }
                            }
                        }
                    }
                });
            }

            highlightActiveMenu();

            // Handle window resize
            $(window).on('resize', function() {
                if ($(window).width() < 768) {
                    $('.app-sidebar').removeClass('sidebar-open');
                } else {
                    $('.app-sidebar').addClass('sidebar-open');
                }
            });
        });
        });

    </script>

