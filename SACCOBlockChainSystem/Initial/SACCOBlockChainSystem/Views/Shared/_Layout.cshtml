                                                <p>Application</p>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a asp-controller="LoanMvc" asp-action="LoansNeedingGuarantors" class="nav-link">
                                                <i class="nav-icon bi bi-people-fill"></i>
                                                <p>Guarantorship</p>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a asp-controller="LoanMvc" asp-action="PendingAppraisal" class="nav-link">
                                                <i class="nav-icon bi bi-clipboard-check"></i>
                                                <p>Appraisal</p>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a asp-controller="LoanMvc" asp-action="PendingEndorsement" class="nav-link">
                                                <i class="nav-icon bi bi-calculator"></i>
                                                <p>Endorsement</p>
                                            </a>
