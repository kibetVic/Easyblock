                                </li>


                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Company" asp-action="Index">
                                        <i class="bi bi-building me-2"></i>
                                        <p>Company Registration</p>
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Agent" asp-action="Index">
                                        <i class="nav-icon bi bi-people"></i>Recruit Agents
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Sms" asp-action="Templates">
                                        <i class="bi bi-file-text me-2"></i>
                                        <span>Generate SMS</span>
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Sms" asp-action="Index">
                                        <i class="bi bi-envelope-paper me-2"></i>
                                        <span>Send SMS</span>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- TRANSACTIONS (formerly LOAN MANAGEMENT) -->
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon bi bi-bank2"></i>
                                <p>
                                    <b>Transactions</b>
