                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="CIGs" asp-action="Index">
                                        <i class="bi bi-people-fill me-2"></i>
                                        <p>CIG</p>
                                    </a>
                                </li>

                                <li class="nav-item">
