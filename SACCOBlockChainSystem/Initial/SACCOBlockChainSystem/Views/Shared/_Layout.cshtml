                            <a asp-controller="Home" asp-action="Index" class="nav-link">
                                <i class="nav-icon bi bi-speedometer2"></i>
                                <p><b>Dashboard</b></p>
                            </a>
                        </li>

                        <!-- System Setups -->
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon bi bi-gear-fill"></i>
                                <p>
                                    <b>System Setups</b>
                                    <i class="nav-arrow bi bi-chevron-right float-end"></i>
                                </p>
                            </a>

                            <ul class="nav nav-treeview ms-4 border-start border-primary border-opacity-25 ps-2">
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Sacco" asp-action="Index">
                                        <i class="bi bi-building me-2"></i>
                                        <span>System Parameters</span>
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a asp-controller="ShareTypeMvc" asp-action="Index" class="nav-link">
