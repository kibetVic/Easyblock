@model List<SACCOBlockChainSystem.Models.Repay>

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">Repayment History</h5>
    </div>
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Receipt No</th>
                            <th>Date</th>
                            <th class="text-end">Amount Paid</th>
                            <th class="text-end">Penalty</th>
                            <th class="text-end">Interest</th>
                            <th class="text-end">Principal</th>
                            <th class="text-end">Balance After</th>
                            <th>Method</th>
                            <th>Status</th>
                            <th>Blockchain</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var repayment in Model.OrderByDescending(r => r.DateReceived))
                        {
                            var isPosted = repayment.Posted == true;
                            <tr class="@(!isPosted ? "table-danger" : "")">
                                <td>
                                    <strong>@repayment.ReceiptNo</strong>
                                    @if (!string.IsNullOrEmpty(repayment.Transno))
                                    {
                                        <br />
                                        <small class="text-muted">Ref: @repayment.Transno</small>
                                    }
                                </td>
                                <td>@(repayment.DateReceived?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                <td class="text-end fw-bold">KES @(repayment.Amount?.ToString("N2") ?? "0.00")</td>
                                <td class="text-end text-warning">KES @(repayment.Penalty?.ToString("N2") ?? "0.00")</td>
                                <td class="text-end text-info">KES @(repayment.Interest?.ToString("N2") ?? "0.00")</td>
                                <td class="text-end text-success">KES @(repayment.Principal?.ToString("N2") ?? "0.00")</td>
                                <td class="text-end">KES @(repayment.LoanBalance?.ToString("N2") ?? "0.00")</td>
                                <td>
                                    <span class="badge bg-light text-dark">
                                        @(!string.IsNullOrEmpty(repayment.Chequeno) ? "Cheque" : "Cash")
                                        @if (!string.IsNullOrEmpty(repayment.Chequeno))
                                        {
                                            <br />
                                            <small>Chq: @repayment.Chequeno</small>
                                        }
                                    </span>
                                </td>
                                <td>
                                    @if (isPosted)
                                    {
                                        <span class="badge bg-success">Posted</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Reversed</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(repayment.BlockchainTxId))
                                    {
                                        <i class="bi bi-shield-check text-success" title="Blockchain Verified"></i>
                                        <span class="text-success ms-1">Verified</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-shield-slash text-muted" title="Not on Blockchain"></i>
                                        <span class="text-muted ms-1">Pending</span>
                                    }
                                </td>
                                <td>
                                    @if (isPosted && (User.IsInRole("Admin") || User.IsInRole("SuperAdmin")))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                onclick="showReverseModal(@repayment.Id, '@repayment.LoanNo')"
                                                title="Reverse Repayment">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                            @if (!isPosted && !string.IsNullOrEmpty(repayment.Remarks) && repayment.Remarks.Contains("Reversed"))
                            {
                                <tr class="table-danger small">
                                    <td colspan="11">
                                        <div class="ps-3">
                                            <i class="bi bi-info-circle me-2"></i>
                                            <strong>Reversal Reason:</strong> @repayment.Remarks
                                            <span class="text-muted ms-3">
                                                Reversed by: @repayment.UserName on @(repayment.AuditDateTime?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="2" class="text-end">Totals:</th>
                            <th class="text-end">KES @Model.Where(r => r.Posted == true).Sum(r => r.Amount ?? 0).ToString("N2")</th>
                            <th class="text-end">KES @Model.Where(r => r.Posted == true).Sum(r => r.Penalty ?? 0).ToString("N2")</th>
                            <th class="text-end">KES @Model.Where(r => r.Posted == true).Sum(r => r.Interest ?? 0).ToString("N2")</th>
                            <th class="text-end">KES @Model.Where(r => r.Posted == true).Sum(r => r.Principal ?? 0).ToString("N2")</th>
                            <th colspan="5"></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-arrow-left-right fs-1 text-muted"></i>
                <p class="text-muted mt-3">No repayments have been recorded yet</p>
            </div>
        }
    </div>
</div>

<!-- Reverse Repayment Modal -->
<div class="modal fade" id="reverseModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ReverseRepayment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="repaymentId" id="reverseRepaymentId" />
                <input type="hidden" name="loanNo" id="reverseLoanNo" />
                <div class="modal-header">
                    <h5 class="modal-title text-danger">Reverse Repayment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Reversing a repayment will undo all allocations and recalculate loan balances. This action cannot be undone.
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Reason for Reversal <span class="text-danger">*</span></label>
                        <textarea name="reason" class="form-control" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Reverse Repayment</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .table th {
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .table td {
        vertical-align: middle;
        font-size: 0.9rem;
    }
</style>

<script>
    function showReverseModal(repaymentId, loanNo) {
        $('#reverseRepaymentId').val(repaymentId);
        $('#reverseLoanNo').val(loanNo);
        $('#reverseModal').modal('show');
    }
</script>