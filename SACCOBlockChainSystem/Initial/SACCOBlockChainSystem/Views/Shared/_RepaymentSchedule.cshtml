@model List<SACCOBlockChainSystem.Models.DTOs.LoanScheduleDTO>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Repayment Schedule</h5>
        @if (Model.Any())
        {
            <div>
                <span class="text-muted me-3">
                    Total: <strong>KES @Model.Sum(s => s.TotalInstallment).ToString("N2")</strong>
                </span>
                <button class="btn btn-sm btn-outline-primary" onclick="printSchedule()">
                    <i class="bi bi-printer"></i> Print / PDF
                </button>
            </div>
        }
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive" id="scheduleContainer">
                <table class="table table-hover align-middle mb-0" id="scheduleTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Due Date</th>
                            <th class="text-end">Principal</th>
                            <th class="text-end">Interest</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">Paid</th>
                            <th class="text-end">Outstanding</th>
                            <th class="text-end">Penalty</th>
                            <th>Status</th>
                            <th>Paid Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            decimal totalPrincipal = 0;
                            decimal totalInterest = 0;
                            decimal totalInstallment = 0;
                            decimal totalPaid = 0;
                            decimal totalOutstanding = 0;
                            decimal totalPenalty = 0;
                        }
                        @foreach (var item in Model)
                        {
                            totalPrincipal += item.PrincipalAmount;
                            totalInterest += item.InterestAmount;
                            totalInstallment += item.TotalInstallment;
                            totalPaid += item.PaidAmount;
                            totalOutstanding += item.OutstandingAmount;
                            totalPenalty += item.PenaltyAmount;

                            var statusClass = item.Status switch
                            {
                                "Paid" => "success",
                                "Partial" => "warning",
                                "Overdue" => "danger",
                                "Pending" => "secondary",
                                _ => "info"
                            };
                            <tr>
                                <td>@item.InstallmentNo</td>
                                <td>@item.DueDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">KES @item.PrincipalAmount.ToString("N2")</td>
                                <td class="text-end">KES @item.InterestAmount.ToString("N2")</td>
                                <td class="text-end fw-bold">KES @item.TotalInstallment.ToString("N2")</td>
                                <td class="text-end text-success">KES @item.PaidAmount.ToString("N2")</td>
                                <td class="text-end @(item.OutstandingAmount > 0 ? "text-danger" : "text-success")">
                                    KES @item.OutstandingAmount.ToString("N2")
                                </td>
                                <td class="text-end text-warning">KES @item.PenaltyAmount.ToString("N2")</td>
                                <td>
                                    <span class="badge bg-@statusClass">@item.Status</span>
                                </td>
                                <td>
                                    @if (item.PaidDate.HasValue)
                                    {
                                        @item.PaidDate.Value.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="2" class="text-end">Totals:</th>
                            <th class="text-end">KES @totalPrincipal.ToString("N2")</th>
                            <th class="text-end">KES @totalInterest.ToString("N2")</th>
                            <th class="text-end">KES @totalInstallment.ToString("N2")</th>
                            <th class="text-end">KES @totalPaid.ToString("N2")</th>
                            <th class="text-end">KES @totalOutstanding.ToString("N2")</th>
                            <th class="text-end">KES @totalPenalty.ToString("N2")</th>
                            <th colspan="2"></th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="row p-3">
                <div class="col-md-6">
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>Payment Priority:</strong> Payments are applied to Penalty first, then Interest, then Principal.
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex justify-content-end gap-3">
                        <div>
                            <span class="badge bg-success">Paid</span> - Fully paid
                        </div>
                        <div>
                            <span class="badge bg-warning">Partial</span> - Partially paid
                        </div>
                        <div>
                            <span class="badge bg-danger">Overdue</span> - Payment overdue
                        </div>
                        <div>
                            <span class="badge bg-secondary">Pending</span> - Not yet due
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-table fs-1 text-muted"></i>
                <p class="text-muted mt-3">No repayment schedule generated yet</p>
            </div>
        }
    </div>
</div>

<script>
    function printSchedule() {
        // Get loan details from ViewBag
        var loanNo = '@(ViewBag.Loan?.LoanNo ?? "")';
        var memberName = '@(ViewBag.Loan?.Member?.Surname ?? "") @(ViewBag.Loan?.Member?.OtherNames ?? "")';
        var loanAmount = '@(ViewBag.Loan?.ApprovedAmount?.ToString("N2") ?? "0.00")';
        var interestRate = '@(ViewBag.Loan?.InterestRate?.ToString("N2") ?? "0")';
        var repaymentPeriod = '@(ViewBag.Loan?.RepaymentPeriod ?? 0)';
        var disbursementDate = '@(ViewBag.Loan?.DisbursementDate?.ToString("dd/MM/yyyy") ?? "N/A")';

        // Get current date
        var currentDate = new Date().toLocaleDateString('en-GB');

        // Clone the table
        var tableContent = document.getElementById('scheduleTable').cloneNode(true);

        // Create print window
        var printWindow = window.open('', '_blank');
        printWindow.document.write(`
            <!DOCTYPE html>
            <html>
                <head>
                    <title>Loan Repayment Schedule - ${loanNo}</title>
                    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
                    <style>
                        body {
                            padding: 20px;
                            font-family: Arial, sans-serif;
                        }
                        .print-header {
                            text-align: center;
                            margin-bottom: 30px;
                            padding-bottom: 20px;
                            border-bottom: 2px solid #333;
                        }
                        .print-header h1 {
                            font-size: 24px;
                            margin-bottom: 10px;
                        }
                        .print-header h3 {
                            font-size: 18px;
                            color: #666;
                            margin-bottom: 5px;
                        }
                        .loan-details {
                            margin-bottom: 20px;
                            padding: 15px;
                            background-color: #f8f9fa;
                            border-radius: 5px;
                        }
                        .loan-details table {
                            width: 100%;
                            border: none;
                        }
                        .loan-details td {
                            padding: 5px;
                            border: none;
                        }
                        .loan-details td:first-child {
                            font-weight: bold;
                            width: 150px;
                        }
                        table {
                            width: 100%;
                            border-collapse: collapse;
                            margin-bottom: 20px;
                        }
                        th, td {
                            border: 1px solid #ddd;
                            padding: 8px;
                            text-align: left;
                        }
                        th {
                            background-color: #f2f2f2;
                            font-weight: bold;
                        }
                        .text-end {
                            text-align: right;
                        }
                        .text-center {
                            text-align: center;
                        }
                        .badge {
                            display: inline-block;
                            padding: 3px 8px;
                            border-radius: 3px;
                            font-size: 12px;
                        }
                        .bg-success {
                            background-color: #28a745;
                            color: white;
                        }
                        .bg-warning {
                            background-color: #ffc107;
                            color: black;
                        }
                        .bg-danger {
                            background-color: #dc3545;
                            color: white;
                        }
                        .bg-secondary {
                            background-color: #6c757d;
                            color: white;
                        }
                        .print-footer {
                            margin-top: 30px;
                            padding-top: 20px;
                            border-top: 1px solid #ddd;
                            text-align: center;
                            font-size: 12px;
                            color: #666;
                        }
                        .text-muted {
                            color: #6c757d;
                        }
                        @@media print {
                            body {
                                margin: 0;
                                padding: 15px;
                            }
                            .no-print {
                                display: none;
                            }
                            .btn {
                                display: none;
                            }
                            .badge {
                                print-color-adjust: exact;
                            }
                        }
                    </style>
                </head>
                <body>
                    <div class="print-header">
                        <h1>Loan Repayment Schedule</h1>
                        <h3>${memberName}</h3>
                        <p>Loan Number: ${loanNo} | Generated: ${currentDate}</p>
                    </div>

                    <div class="loan-details">
                        <table>
                            <tr>
                                <td>Loan Amount:</td>
                                <td><strong>KES ${loanAmount}</strong></td>
                                <td>Interest Rate:</td>
                                <td><strong>${interestRate}% p.a.</strong></td>
                            </tr>
                            <tr>
                                <td>Repayment Period:</td>
                                <td><strong>${repaymentPeriod} months</strong></td>
                                <td>Disbursement Date:</td>
                                <td><strong>${disbursementDate}</strong></td>
                            </tr>
                        </table>
                    </div>

                    ${tableContent.outerHTML}

                    <div class="print-footer">
                        <p>This is a computer-generated document. No signature required.</p>
                        <p>Payment Priority: Penalty first, then Interest, then Principal</p>
                        <p>For any queries, please contact the Loans Department.</p>
                    </div>

                    <div class="text-center no-print" style="margin-top: 20px;">
                        <button onclick="window.print()" class="btn btn-primary">Print Now</button>
                        <button onclick="window.close()" class="btn btn-secondary">Close</button>
                    </div>
                </body>
            </html>
        `);

        printWindow.document.close();
        printWindow.focus();

        // Auto-trigger print dialog
        printWindow.print();
    }
</script>