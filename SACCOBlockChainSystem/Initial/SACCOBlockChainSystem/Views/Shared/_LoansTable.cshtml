@model List<SACCOBlockChainSystem.Models.DTOs.LoanSummaryDTO>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Loans List</h5>
        <span class="badge bg-primary">@Model.Count Loans</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Loan No</th>
                            <th>Member</th>
                            <th>Loan Type</th>
                            @* <th class="text-end">Applied Amount</th> *@
                            <th class="text-end">PrincipalAmount</th>
                            <th class="text-end">Approved</th>
                            <th class="text-end">Loan Balance</th>
                            <th>Application Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var loan in Model)
                        {
                            var statusColor = loan.LoanStatus switch
                            {
                                "Draft" => "secondary",
                                "Submitted" => "info",
                                "UnderAppraisal" => "warning",
                                "Approved" => "success",
                                "Endorsed" => "info",
                                "Rejected" => "danger",
                                "Disbursed" => "success",
                                "Closed" => "secondary",
                                "WrittenOff" => "dark",
                                _ => "secondary"
                            };

                            // Get MaxLoanamt from the loan object (need to pass it from controller)
                            var maxLoanAmount = loan.MaxLoanamt > 0 ? loan.MaxLoanamt : loan.PrincipalAmount;
                            
                            // Check if applied amount exceeds max eligible
                            var isExceedingMax = loan.PrincipalAmount > maxLoanAmount;
                            var principalClass = isExceedingMax ? "text-danger fw-bold" : "text-dark";

                            // Calculate approved amount (from Endmain)
                            var approvedAmount = loan.ApprovedAmount > 0 ? loan.ApprovedAmount : loan.PrincipalAmount;

                            // Outstanding balance from Loanbal table (Balance field)
                            var outstandingBalance = loan.OutstandingBalance;
                            var outstandingClass = outstandingBalance > 0 ? "text-danger fw-bold" : "text-success fw-bold";
                            var outstandingDisplay = outstandingBalance > 0 ? $"KES {outstandingBalance:N0}" : "KES 0";

                            <tr>
                                <td>
                                    <strong>@loan.LoanNo</strong>
                                </td>
                                <td>
                                    <div>@loan.MemberName</div>
                                    <small class="text-muted">@loan.MemberNo</small>
                                </td>
                                <td>@loan.LoanType</td>
                                @* <td class="text-end @principalClass">
                                    KES @loan.PrincipalAmount.ToString("N0")
                                </td> *@
                                <td class="text-end text-info fw-bold">
                                    KES @maxLoanAmount.ToString("N0")
                                </td>
                                <td class="text-end text-primary fw-bold">
                                    KES @approvedAmount.ToString("N0")
                                </td>
                                <td class="text-end @outstandingClass">
                                    @outstandingDisplay
                                </td>
                                <td>@loan.ApplicationDate.ToString("dd/MM/yyyy")</td>
                                <td class="table-actions">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-loanNo="@loan.LoanNo"
                                           class="btn btn-sm btn-outline-primary"
                                           data-bs-toggle="tooltip"
                                           title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (loan.LoanStatus == "Draft" || loan.LoanStatus == "Submitted")
                                        {
                                            <a asp-action="AssignGuarantor" asp-route-loanNo="@loan.LoanNo"
                                               class="btn btn-sm btn-outline-warning"
                                               data-bs-toggle="tooltip"
                                               title="Assign Guarantors">
                                                <i class="bi bi-people"></i>
                                            </a>
                                        }

                                        @if (loan.LoanStatus == "Submitted")
                                        {
                                            <a asp-action="Appraise" asp-route-loanNo="@loan.LoanNo"
                                               class="btn btn-sm btn-outline-info"
                                               data-bs-toggle="tooltip"
                                               title="Appraise">
                                                <i class="bi bi-clipboard-check"></i>
                                            </a>
                                        }

                                        @if (loan.LoanStatus == "Approved")
                                        {
                                            <a asp-action="Endorse" asp-route-loanNo="@loan.LoanNo"
                                               class="btn btn-sm btn-outline-info"
                                               data-bs-toggle="tooltip"
                                               title="Endorse">
                                                <i class="bi bi-calendar-check"></i>
                                            </a>
                                        }

                                        @if (loan.LoanStatus == "Endorsed")
                                        {
                                            <a asp-action="Disburse" asp-route-loanNo="@loan.LoanNo"
                                               class="btn btn-sm btn-outline-success"
                                               data-bs-toggle="tooltip"
                                               title="Disburse">
                                                <i class="bi bi-cash-stack"></i>
                                            </a>
                                        }

                                        @if (loan.LoanStatus == "Disbursed")
                                        {
                                            <a asp-action="Repay" asp-route-loanNo="@loan.LoanNo"
                                               class="btn btn-sm btn-outline-primary"
                                               data-bs-toggle="tooltip"
                                               title="Make Payment">
                                                <i class="bi bi-arrow-left-right"></i>
                                            </a>
                                        }

                                        <a asp-action="Schedule" asp-route-loanNo="@loan.LoanNo"
                                           class="btn btn-sm btn-outline-secondary"
                                           data-bs-toggle="tooltip"
                                           title="View Schedule">
                                            <i class="bi bi-table"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-files fs-1 text-muted"></i>
                <p class="text-muted mt-3">No loans found</p>
                <a asp-action="Apply" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Create New Loan
                </a>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .progress-sm {
            height: 6px;
        }

        .table-actions .btn-group {
            gap: 4px;
        }

        .table-actions .btn {
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            font-size: 0.75rem;
            font-weight: 500;
        }

        .loan-status {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: currentColor;
        }

        .table tbody tr:hover {
            background-color: rgba(0, 0, 0, 0.02);
        }

        .table td.text-end.text-danger {
            font-weight: 600;
        }

        .table td.text-end.text-success {
            font-weight: 600;
        }
        
        .table td.text-end.text-info {
            font-weight: 600;
        }
    </style>
}

@section Scripts {
    <script>
        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    </script>
}