@model SACCOBlockChainSystem.Models.ShareTransfer
@{
    ViewData["Title"] = "Share Transfer Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary me-3">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                    <h2 class="page-title d-inline-block mb-0">
                        <i class="bi bi-arrow-left-right me-2"></i>Share Transfer Details
                    </h2>
                </div>
                <div>
                    <!-- Add this to the action buttons section in Details.cshtml -->
                    @if (Model.Status == "Pending")
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                            <i class="bi bi-pencil me-1"></i> Edit
                        </a>
                        <button type="button" class="btn btn-success me-2" data-bs-toggle="modal" data-bs-target="#approveModal">
                            <i class="bi bi-check-circle me-1"></i> Approve
                        </button>
                        <button type="button" class="btn btn-danger me-2" data-bs-toggle="modal" data-bs-target="#rejectModal">
                            <i class="bi bi-x-circle me-1"></i> Reject
                        </button>
                        <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#cancelModal">
                            <i class="bi bi-ban me-1"></i> Cancel
                        </button>
                    }
                    @if (Model.Status == "Approved")
                    {
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#completeModal">
                            <i class="bi bi-check2-circle me-1"></i> Complete Transfer
                        </button>
                    }

                   @*  @if (Model.Status == "Pending")
                    {
                        <button type="button" class="btn btn-success me-2" data-bs-toggle="modal" data-bs-target="#approveModal">
                            <i class="bi bi-check-circle me-1"></i> Approve
                        </button>
                        <button type="button" class="btn btn-danger me-2" data-bs-toggle="modal" data-bs-target="#rejectModal">
                            <i class="bi bi-x-circle me-1"></i> Reject
                        </button>
                        <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#cancelModal">
                            <i class="bi bi-ban me-1"></i> Cancel
                        </button>
                    }
                    @if (Model.Status == "Approved")
                    {
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#completeModal">
                            <i class="bi bi-check2-circle me-1"></i> Complete Transfer
                        </button>
                    }
                    @if (Model.Status == "Pending")
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="bi bi-pencil me-1"></i> Edit
                        </a>
                    } *@
                </div>
            </div>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <!-- Transfer Details Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-file-text me-2"></i>Transfer Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="text-muted">Transfer Number:</label>
                                <p class="fw-bold mb-0">@Model.TransferNo</p>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted">Transfer Date:</label>
                                <p class="mb-0">@Model.TransferDate.ToString("dd/MM/yyyy")</p>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted">Transfer Type:</label>
                                <p class="mb-0">@Model.TransferType</p>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted">Status:</label>
                                <p class="mb-0">
                                    @if (Model.Status == "Pending")
                                    {
                                        <span class="badge bg-warning">Pending</span>
                                    }
                                    else if (Model.Status == "Approved")
                                    {
                                        <span class="badge bg-info">Approved</span>
                                    }
                                    else if (Model.Status == "Completed")
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }
                                    else if (Model.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger">Rejected</span>
                                    }
                                    else if (Model.Status == "Cancelled")
                                    {
                                        <span class="badge bg-secondary">Cancelled</span>
                                    }
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="text-muted">Share Type:</label>
                                <p class="fw-bold mb-0">@Model.ShareType?.SharesType (@Model.SharesCode)</p>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted">Number of Shares:</label>
                                <p class="mb-0">@Model.NumberOfShares.ToString("N0")</p>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted">Price per Share:</label>
                                <p class="mb-0">KES @Model.PricePerShare.ToString("N2")</p>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted">Total Amount:</label>
                                <p class="fw-bold text-primary">KES @Model.TotalAmount.ToString("N2")</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Parties Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-people me-2"></i>Parties Involved
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-header bg-primary text-white">
                                    <i class="bi bi-person me-2"></i>Transferor (Seller)
                                </div>
                                <div class="card-body">
                                    <div class="mb-2">
                                        <label class="text-muted">Member Number:</label>
                                        <p class="fw-bold mb-0">@Model.TransferorMemberNo</p>
                                    </div>
                                    <div class="mb-2">
                                        <label class="text-muted">Name:</label>
                                        <p class="mb-0">@Model.Transferor?.Surname @Model.Transferor?.OtherNames</p>
                                    </div>
                                    <div class="mb-2">
                                        <label class="text-muted">Balance Before Transfer:</label>
                                        <p class="mb-0">@Model.TransferorBalanceBefore.ToString("N0") shares</p>
                                    </div>
                                    <div class="mb-2">
                                        <label class="text-muted">Balance After Transfer:</label>
                                        <p class="fw-bold text-primary">@Model.TransferorBalanceAfter.ToString("N0") shares</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-header bg-success text-white">
                                    <i class="bi bi-person-check me-2"></i>Transferee (Buyer)
                                </div>
                                <div class="card-body">
                                    <div class="mb-2">
                                        <label class="text-muted">Member Number:</label>
                                        <p class="fw-bold mb-0">@Model.TransfereeMemberNo</p>
                                    </div>
                                    <div class="mb-2">
                                        <label class="text-muted">Name:</label>
                                        <p class="mb-0">@Model.Transferee?.Surname @Model.Transferee?.OtherNames</p>
                                    </div>
                                    <div class="mb-2">
                                        <label class="text-muted">Balance Before Transfer:</label>
                                        <p class="mb-0">@Model.TransfereeBalanceBefore.ToString("N0") shares</p>
                                    </div>
                                    <div class="mb-2">
                                        <label class="text-muted">Balance After Transfer:</label>
                                        <p class="fw-bold text-primary">@Model.TransfereeBalanceAfter.ToString("N0") shares</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Charges Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-calculator me-2"></i>Charges Breakdown
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Total Amount:</strong></td>
                                    <td class="text-end">KES @Model.TotalAmount.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td>Transfer Fee (1%):</td>
                                    <td class="text-end">KES @Model.TransferFee.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td>Stamp Duty (0.5%):</td>
                                    <td class="text-end">KES @Model.StampDuty.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td>Other Charges:</td>
                                    <td class="text-end">KES @Model.OtherCharges.ToString("N2")</td>
                                </tr>
                                <tr class="border-top">
                                    <td><strong>Total Charges:</strong></td>
                                    <td class="text-end text-danger">KES @Model.TotalCharges.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td><strong>Net to Transferor:</strong></td>
                                    <td class="text-end text-success fw-bold">KES @((Model.TotalAmount - Model.TotalCharges).ToString("N2"))</td>
                                </tr>
                            </table>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.PaymentMethod))
                        {
                            <div class="col-md-6">
                                <div class="alert alert-info">
                                    <strong>Payment Details:</strong><br />
                                    Method: @Model.PaymentMethod<br />
                                    Reference: @Model.PaymentReference
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Remarks and Documents -->
            @if (!string.IsNullOrEmpty(Model.Remarks) || !string.IsNullOrEmpty(Model.TransferDocumentPath))
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-paperclip me-2"></i>Additional Information
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Model.Remarks))
                        {
                            <div class="mb-3">
                                <label class="text-muted">Remarks:</label>
                                <p class="mb-0">@Model.Remarks</p>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.TransferDocumentPath))
                        {
                            <div>
                                <label class="text-muted">Document:</label>
                                <p>
                                    <a href="@Model.TransferDocumentPath" target="_blank" class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-file-earmark-text"></i> View Document
                                    </a>
                                </p>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Approval History -->
            @if (Model.Approvals.Any())
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-check2-circle me-2"></i>Approval History
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Level</th>
                                        <th>Status</th>
                                        <th>Approved By</th>
                                        <th>Date</th>
                                        <th>Comments</th>
                                </thead>
                                <tbody>
                                    @foreach (var approval in Model.Approvals.OrderBy(a => a.ApprovalDate))
                                    {
                                        <tr>
                                            <td>@approval.ApprovalLevel</td>
                                            <td>
                                                @if (approval.ApprovalStatus == "Approved")
                                                {
                                                    <span class="badge bg-success">Approved</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Rejected</span>
                                                }
                                            </td>
                                            <td>@approval.ApprovedBy</td>
                                            <td>@approval.ApprovalDate?.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@approval.Comments</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- Blockchain Information -->
            @if (!string.IsNullOrEmpty(Model.BlockchainTxId))
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-link-45deg me-2"></i>Blockchain Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <label class="text-muted">Transaction ID:</label>
                            <p class="mb-0"><code>@Model.BlockchainTxId</code></p>
                        </div>
                        <div class="mb-2">
                            <label class="text-muted">Created At:</label>
                            <p class="mb-0">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Timeline Sidebar -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-clock-history me-2"></i>Timeline
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <i class="bi bi-plus-circle text-primary me-2"></i>
                            <strong>Created:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            <br />
                            <small class="text-muted">By: @Model.CreatedBy</small>
                        </li>
                        @if (Model.ApprovalDate.HasValue)
                        {
                            <li class="list-group-item">
                                <i class="bi bi-check-circle text-success me-2"></i>
                                <strong>Approved:</strong> @Model.ApprovalDate?.ToString("dd/MM/yyyy HH:mm")
                                <br />
                                <small class="text-muted">By: @Model.ApprovedBy</small>
                            </li>
                        }
                        @if (Model.ModifiedAt.HasValue && Model.Status == "Completed")
                        {
                            <li class="list-group-item">
                                <i class="bi bi-check2-circle text-info me-2"></i>
                                <strong>Completed:</strong> @Model.ModifiedAt?.ToString("dd/MM/yyyy HH:mm")
                                <br />
                                <small class="text-muted">By: @Model.ModifiedBy</small>
                            </li>
                        }
                        @if (Model.ModifiedAt.HasValue && Model.Status == "Cancelled")
                        {
                            <li class="list-group-item">
                                <i class="bi bi-ban text-warning me-2"></i>
                                <strong>Cancelled:</strong> @Model.ModifiedAt?.ToString("dd/MM/yyyy HH:mm")
                                <br />
                                <small class="text-muted">By: @Model.ModifiedBy</small>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Approve Modal -->
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Approve" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Approve Share Transfer</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Comments (Optional)</label>
                        <textarea name="comments" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>Transfer Details:</strong><br />
                        Transferor: @Model.Transferor?.Surname @Model.Transferor?.OtherNames<br />
                        Transferee: @Model.Transferee?.Surname @Model.Transferee?.OtherNames<br />
                        Shares: @Model.NumberOfShares @Model.ShareType?.SharesType<br />
                        Amount: KES @Model.TotalAmount.ToString("N2")
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Confirm Approval</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Reject" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Reject Share Transfer</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Reason for Rejection *</label>
                        <textarea name="reason" class="form-control" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Cancel Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Cancel" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">Cancel Share Transfer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Reason for Cancellation *</label>
                        <textarea name="reason" class="form-control" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Confirm Cancellation</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Complete Modal -->
<div class="modal fade" id="completeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Complete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Complete Share Transfer</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>Confirm Transfer Completion:</strong><br /><br />
                        This action will:
                        <ul class="mt-2">
                            <li>Deduct @Model.NumberOfShares shares from @Model.Transferor?.Surname @Model.Transferor?.OtherNames</li>
                            <li>Add @Model.NumberOfShares shares to @Model.Transferee?.Surname @Model.Transferee?.OtherNames</li>
                            <li>Record the transaction on the blockchain</li>
                        </ul>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Complete Transfer</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}