@model List<SACCOBlockChainSystem.Models.DTOs.ShareTransferResponseDTO>
@{
    ViewData["Title"] = "Share Transfers";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentStatus = ViewBag.CurrentStatus as string ?? "All";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary me-3">
                        <i class="bi bi-arrow-left"></i> Back to Dashboard
                    </a>
                    <h2 class="page-title d-inline-block mb-0">
                        <i class="bi bi-arrow-left-right me-2"></i>Share Transfers
                    </h2>
                </div>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>New Share Transfer
                </a>
            </div>
        </div>
    </div>

    <!-- Status Filter -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="btn-group" role="group">
                <a asp-action="Index" asp-route-status="All" class="btn @(currentStatus == "All" ? "btn-primary" : "btn-outline-primary")">
                    All
                </a>
                <a asp-action="Index" asp-route-status="Pending" class="btn @(currentStatus == "Pending" ? "btn-warning" : "btn-outline-warning")">
                    <i class="bi bi-clock-history"></i> Pending
                </a>
                <a asp-action="Index" asp-route-status="Approved" class="btn @(currentStatus == "Approved" ? "btn-info" : "btn-outline-info")">
                    <i class="bi bi-check-circle"></i> Approved
                </a>
                <a asp-action="Index" asp-route-status="Completed" class="btn @(currentStatus == "Completed" ? "btn-success" : "btn-outline-success")">
                    <i class="bi bi-check2-circle"></i> Completed
                </a>
                <a asp-action="Index" asp-route-status="Rejected" class="btn @(currentStatus == "Rejected" ? "btn-danger" : "btn-outline-danger")">
                    <i class="bi bi-x-circle"></i> Rejected
                </a>
                <a asp-action="Index" asp-route-status="Cancelled" class="btn @(currentStatus == "Cancelled" ? "btn-secondary" : "btn-outline-secondary")">
                    <i class="bi bi-ban"></i> Cancelled
                </a>
            </div>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="card-title mb-0">
                <i class="bi bi-table me-2"></i>Share Transfer Requests
            </h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="transfersTable">
                    <thead class="table-light">
                        <tr>
                            <th>Transfer No</th>
                            <th>Transferor</th>
                            <th>Transferee</th>
                            <th>Shares Type</th>
                            <th>Shares</th>
                            <th>Price/Share</th>
                            <th>Total Amount</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var transfer in Model)
                            {
                                <tr>
                                    <td><strong>@transfer.TransferNo</strong></td>
                                    <td>@transfer.TransferorName (@transfer.TransferorMemberNo)</td>
                                    <td>@transfer.TransfereeName (@transfer.TransfereeMemberNo)</td>
                                    <td>@transfer.SharesType</td>
                                    <td class="text-end">@transfer.NumberOfShares.ToString("N0")</td>
                                    <td class="text-end">KES @transfer.PricePerShare.ToString("N2")</td>
                                    <td class="text-end fw-bold">KES @transfer.TotalAmount.ToString("N2")</td>
                                    <td>@transfer.TransferDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (transfer.Status == "Pending")
                                        {
                                            <span class="badge bg-warning">Pending</span>
                                        }
                                        else if (transfer.Status == "Approved")
                                        {
                                            <span class="badge bg-info">Approved</span>
                                        }
                                        else if (transfer.Status == "Completed")
                                        {
                                            <span class="badge bg-success">Completed</span>
                                        }
                                        else if (transfer.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">Rejected</span>
                                        }
                                        else if (transfer.Status == "Cancelled")
                                        {
                                            <span class="badge bg-secondary">Cancelled</span>
                                        }
                                    </td>
                                    <!-- In the Actions column of Index.cshtml -->
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@transfer.Id" class="btn btn-sm btn-outline-info">
                                                <i class="bi bi-eye"></i> View
                                            </a>
                                            @if (transfer.Status == "Pending")
                                            {
                                                <a asp-action="Edit" asp-route-id="@transfer.Id" class="btn btn-sm btn-outline-warning">
                                                    <i class="bi bi-pencil"></i> Edit
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted py-4">
                                    <i class="bi bi-info-circle me-2"></i>No share transfer requests found
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#transfersTable').DataTable({
                pageLength: 10,
                ordering: true,
                responsive: true,
                language: {
                    lengthMenu: "Show _MENU_ transfers per page",
                    info: "Showing _START_ to _END_ of _TOTAL_ transfers",
                    infoEmpty: "No transfers found",
                    zeroRecords: "No matching transfers found"
                }
            });
        });
    </script>
}