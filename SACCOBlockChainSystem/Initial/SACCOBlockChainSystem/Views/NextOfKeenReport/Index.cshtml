@model SACCOBlockChainSystem.Models.ViewModels.NextOfKinReportViewModel

@{
    ViewData["Title"] = "All Members - Next of Kin Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <a asp-controller="NextOfKeen" asp-action="Index" class="btn btn-outline-secondary me-3">
                        <i class="bi bi-arrow-left"></i> Back to Next of Kin
                    </a>
                    <h2 class="page-title d-inline-block mb-0">
                        <i class="bi bi-file-text me-2"></i>All Members - Next of Kin Report
                    </h2>
                </div>
                <div>
                    <div class="btn-group">
                        <a href="@Url.Action("ExportExcel")" class="btn btn-success">
                            <i class="bi bi-file-excel me-2"></i>Export to Excel
                        </a>
                        <a href="@Url.Action("ExportPdf")" class="btn btn-danger">
                            <i class="bi bi-file-pdf me-2"></i>Export to PDF
                        </a>
                        <a href="@Url.Action("Print")" class="btn btn-info" target="_blank">
                            <i class="bi bi-printer me-2"></i>Print
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <!-- Company Header -->
            <div class="text-center mb-4">
                <h2 style="color: #3f2b96;">@Model.CompanyName</h2>
                <p>@Model.CompanyAddress</p>
                <p>Tel: @Model.CompanyPhone | Email: @Model.CompanyEmail</p>
                <hr />
                <p><strong>Report Generated:</strong> @Model.GeneratedDate.ToString("dd/MM/yyyy HH:mm:ss") | <strong>Generated By:</strong> @Model.GeneratedBy</p>
                <h4 class="mt-3">@Model.ReportTitle</h4>
            </div>

            <!-- Summary Cards -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card bg-primary text-white">
                        <div class="card-body">
                            <h6 class="card-title">Total Members</h6>
                            <h3 class="mb-0">@Model.Summary.TotalMembers</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body">
                            <h6 class="card-title">Total Next of Kin</h6>
                            <h3 class="mb-0">@Model.Summary.TotalNextOfKeens</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-warning text-white">
                        <div class="card-body">
                            <h6 class="card-title">Complete Benefit (≤100%)</h6>
                            <h3 class="mb-0">@Model.Summary.MembersWithCompleteBenefit</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-danger text-white">
                        <div class="card-body">
                            <h6 class="card-title">Invalid Benefit (>100%)</h6>
                            <h3 class="mb-0">@Model.Summary.MembersWithInvalidBenefit</h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Members Table -->
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="reportTable">
                    <thead class="table-primary">
                        <tr>
                            <th>Member No</th>
                            <th>Member Name</th>
                            <th>ID Number</th>
                            <th>Phone</th>
                            <th>Status</th>
                            <th>Total NOK</th>
                            <th>Benefit %</th>
                            <th>NOK Name</th>
                            <th>Relationship</th>
                            <th>NOK Phone</th>
                            <th>Benefit %</th>
                            <th>Primary</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in Model.MembersWithNextOfKin)
                        {
                            if (member.NextOfKeens.Any())
                            {
                                foreach (var nok in member.NextOfKeens)
                                {
                                    <tr class="@(!member.HasValidBenefit ? "table-danger" : "")">
                                        <td>@member.MemberNo</td>
                                        <td>@member.FullName</td>
                                        <td>@(member.IdNumber ?? "-")</td>
                                        <td>@(member.PhoneNo ?? "-")</td>
                                        <td>@member.Status</td>
                                        <td class="text-center">@member.TotalNextOfKeens</td>
                                        <td>@member.TotalBenefitPercentage.ToString("F2")%</td>
                                        <td>@nok.FullName</td>
                                        <td>@nok.Relationship</td>
                                        <td>@nok.PhoneNo</td>
                                        <td>@(nok.BenefitPercentage?.ToString("F2") ?? "0")%</td>
                                        <td>@(nok.IsPrimary ? "Yes" : "No")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td>@member.MemberNo</td>
                                    <td>@member.FullName</td>
                                    <td>@(member.IdNumber ?? "-")</td>
                                    <td>@(member.PhoneNo ?? "-")</td>
                                    <td>@member.Status</td>
                                    <td class="text-center">0</td>
                                    <td>0%</td>
                                    <td colspan="6" class="text-muted">No next of kin recorded</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-center mt-4 pt-3 border-top">
                <small class="text-muted">
                    This is a computer-generated document. No signature is required.<br />
                    Page 1 of 1
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#reportTable').DataTable({
                pageLength: 25,
                ordering: true,
                responsive: true,
                language: {
                    search: "Search:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ entries"
                }
            });
        });
    </script>
}