@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Pending Appraisal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex align-items-center mb-4">
                <a asp-action="AllLoans" class="btn btn-outline-secondary me-3">
                    <i class="bi bi-arrow-left"></i> Back to Dashboard
                </a>
                <h2 class="page-title mb-0">
                    <i class="bi bi-clipboard-check me-2"></i>Loans Pending Appraisal
                </h2>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-check-circle fs-1"></i>
            <h5 class="mt-3">No loans pending appraisal</h5>
            <p class="mb-0">All submitted loans have been appraised.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">
                    <i class="bi bi-list-check me-2"></i>Loans Ready for Appraisal
                </h5>
                <small class="text-muted">These loans have passed application and guarantor requirements</small>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Loan No</th>
                                <th>Member Name</th>
                                <th>Loan Type</th>
                                <th>Applied Amount</th>
                                <th>Total Guarantee</th>
                                <th>Application Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var loan in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@loan.LoanNo</strong>
                                    </td>
                                    <td>@loan.MemberName</td>
                                    <td>@loan.LoanType</td>
                                    <td class="text-end">KES @loan.PrincipalAmount.ToString("N0")</td>
                                    <td class="text-end">
                                        @if (loan.TotalGuarantee > 0)
                                        {
                                            <span class="badge bg-success">KES @loan.TotalGuarantee.ToString("N0")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No Guarantors</span>
                                        }
                                    </td>
                                    <td>@loan.ApplicationDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <a asp-action="Appraise" asp-route-loanNo="@loan.LoanNo"
                                           class="btn btn-sm btn-primary">
                                            <i class="bi bi-clipboard-check"></i> Appraise
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>