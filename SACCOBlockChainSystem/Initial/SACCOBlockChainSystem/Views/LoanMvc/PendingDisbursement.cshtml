@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Pending Disbursement";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <a asp-action="AllLoans" class="btn btn-outline-secondary me-3">
                        <i class="bi bi-arrow-left"></i> Back to Dashboard
                    </a>
                    <h2 class="page-title mb-0">
                        <i class="bi bi-cash-stack me-2"></i>Loans Ready for Disbursement
                    </h2>
                </div>
                <div class="text-muted">
                    <i class="bi bi-info-circle me-1"></i> Loans in <strong>Endorsed</strong> status ready for disbursement
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-check-circle fs-1"></i>
            <h5 class="mt-3">No loans ready for disbursement</h5>
            <p class="mb-0">All endorsed loans have been disbursed or are pending approval.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">
                    <i class="bi bi-list-check me-2"></i>Loans Ready for Disbursement
                </h5>
                <small class="text-muted">These loans have been endorsed and are ready for funds release</small>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover" id="disbursementTable">
                        <thead class="table-light">
                            <tr>
                                <th>Loan No</th>
                                <th>Member Name</th>
                                <th>Loan Type</th>
                                <th class="text-end">Gross Amount</th>
                                <th class="text-end">Deductions</th>
                                <th class="text-end">Net Amount</th>
                                <th>Application Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var loan in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@loan.LoanNo</strong>
                                    </td>
                                    <td>@loan.MemberName</td>
                                    <td>@loan.LoanType</td>
                                    <td class="text-end text-primary">KES @loan.GrossAmount.ToString("N0")</td>
                                    <td class="text-end text-danger">KES @loan.TotalDeductions.ToString("N0")</td>
                                    <td class="text-end fw-bold text-success">KES @loan.NetAmount.ToString("N0")</td>
                                    <td>@loan.ApplicationDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <a asp-action="Disburse" asp-route-loanNo="@loan.LoanNo"
                                           class="btn btn-sm btn-success">
                                            <i class="bi bi-cash-stack"></i> Disburse
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Summary Card -->
        <div class="row mt-4">
            <div class="col-md-12">
                <div class="card bg-light">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h6 class="text-muted">Total Loans</h6>
                                    <h3 class="mb-0">@Model.Count()</h3>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h6 class="text-muted">Total Gross Amount</h6>
                                    <h3 class="mb-0 text-primary">KES @Model.Sum(l => (decimal)l.GrossAmount).ToString("N0")</h3>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h6 class="text-muted">Total Deductions</h6>
                                    <h3 class="mb-0 text-danger">KES @Model.Sum(l => (decimal)l.TotalDeductions).ToString("N0")</h3>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h6 class="text-muted">Total Net Amount</h6>
                                    <h3 class="mb-0 text-success">KES @Model.Sum(l => (decimal)l.NetAmount).ToString("N0")</h3>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            if ($.fn.DataTable) {
                $('#disbursementTable').DataTable({
                    pageLength: 10,
                    ordering: true,
                    responsive: true,
                    language: {
                        search: "Search loans:",
                        lengthMenu: "Show _MENU_ loans per page",
                        info: "Showing _START_ to _END_ of _TOTAL_ loans",
                        infoEmpty: "No loans found",
                        zeroRecords: "No matching loans found"
                    }
                });
            }
        });
    </script>
}