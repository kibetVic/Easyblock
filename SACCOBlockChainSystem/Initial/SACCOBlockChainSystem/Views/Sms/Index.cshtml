@model List<SACCOBlockChainSystem.Models.DTOs.SmsResponseDTO>
@{
    ViewData["Title"] = "SMS Messages";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var statistics = ViewBag.Statistics as SACCOBlockChainSystem.Models.DTOs.SmsStatisticsDTO;
    var currentStatus = ViewBag.CurrentStatus as string;
    var currentPhoneNumber = ViewBag.CurrentPhoneNumber as string;
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary me-3">
                        <i class="bi bi-arrow-left"></i> Back to Dashboard
                    </a>
                    <h2 class="page-title d-inline-block mb-0">
                        <i class="bi bi-envelope-paper me-2"></i>SMS Messages
                    </h2>
                </div>
                <div>
                    <a asp-action="Send" class="btn btn-primary me-2">
                        <i class="bi bi-send me-1"></i> Send SMS
                    </a>
                    <a asp-action="BulkSend" class="btn btn-outline-primary">
                        <i class="bi bi-envelope-plus me-1"></i> Bulk Send
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    @if (statistics != null)
    {
        <div class="row mb-4">
            <div class="col-md-2">
                <div class="card bg-primary text-white shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title">Total Sent</h6>
                        <h3 class="mb-0">@statistics.TotalSent</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card bg-warning text-white shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title">Pending</h6>
                        <h3 class="mb-0">@statistics.TotalPending</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card bg-danger text-white shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title">Failed</h6>
                        <h3 class="mb-0">@statistics.TotalFailed</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card bg-success text-white shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title">Delivered</h6>
                        <h3 class="mb-0">@statistics.TotalDelivered</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card bg-info text-white shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title">Total Cost</h6>
                        <h3 class="mb-0">KES @statistics.TotalCost.ToString("N2")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <a asp-action="Statistics" class="card bg-secondary text-white shadow-sm text-decoration-none">
                    <div class="card-body">
                        <h6 class="card-title">View Stats</h6>
                        <h3 class="mb-0">
                            <i class="bi bi-graph-up"></i> Details
                        </h3>
                    </div>
                </a>
            </div>
        </div>
    }

    <!-- Search/Filter Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="card-title mb-0">
                <i class="bi bi-funnel me-2"></i>Filter Messages
            </h5>
        </div>
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Filter by Status</label>
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        <option value="">-- All Status --</option>
                        <option value="Pending" selected="@(currentStatus == "Pending")">Pending</option>
                        <option value="Sent" selected="@(currentStatus == "Sent")">Sent</option>
                        <option value="Delivered" selected="@(currentStatus == "Delivered")">Delivered</option>
                        <option value="Failed" selected="@(currentStatus == "Failed")">Failed</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Filter by Phone Number</label>
                    <input type="text" name="phoneNumber" class="form-control"
                           placeholder="Enter phone number..." value="@currentPhoneNumber" />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="bi bi-search"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-eraser"></i> Clear
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- SMS Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="card-title mb-0">
                <i class="bi bi-table me-2"></i>SMS Messages
            </h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="smsTable">
                    <thead class="table-light">
                        <tr>
                            <th>Message ID</th>
                            <th>Phone Number</th>
                            <th>Recipient</th>
                            <th>Message Type</th>
                            <th>Message Preview</th>
                            <th>Status</th>
                            <th>Sent At</th>
                            <th>Cost</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var sms in Model)
                            {
                                <tr>
                                    <td><code>@sms.MessageId</code></td>
                                    <td>@sms.PhoneNumber</td>
                                    <td>@sms.RecipientName</td>
                                    <td>
                                        <span class="badge bg-secondary">@sms.MessageType</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(sms.MessageContent))
                                        {
                                            if (sms.MessageContent.Length > 50)
                                            {
                                                @sms.MessageContent.Substring(0, 50)
                                
                                                <text>...</text>
                                            }
                                            else
                                            {
                                                @sms.MessageContent
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">No content</span>
                                        }
                                    </td>
                                    <td>
                                        @if (sms.Status == "Sent")
                                        {
                                            <span class="badge bg-info">Sent</span>
                                        }
                                        else if (sms.Status == "Delivered")
                                        {
                                            <span class="badge bg-success">Delivered</span>
                                        }
                                        else if (sms.Status == "Pending")
                                        {
                                            <span class="badge bg-warning">Pending</span>
                                        }
                                        else if (sms.Status == "Failed")
                                        {
                                            <span class="badge bg-danger">Failed</span>
                                        }
                                    </td>
                                    <td>@(sms.SentAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                    <td class="text-end">@(sms.Cost?.ToString("N2") ?? "-")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@sms.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (sms.Status == "Failed")
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-warning"
                                                        onclick="resendSms(@sms.Id)" title="Resend">
                                                    <i class="bi bi-arrow-repeat"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">
                                    <i class="bi bi-info-circle me-2"></i>No SMS messages found
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#smsTable').DataTable({
                pageLength: 20,
                ordering: true,
                responsive: true,
                order: [[6, 'desc']],
                language: {
                    lengthMenu: "Show _MENU_ messages per page",
                    info: "Showing _START_ to _END_ of _TOTAL_ messages",
                    infoEmpty: "No messages found",
                    zeroRecords: "No matching messages found"
                }
            });
        });

        async function resendSms(id) {
            if (!confirm('Are you sure you want to resend this SMS?')) {
                return;
            }

            try {
                const response = await fetch(`/Sms/Resend/${id}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    }
                });

                const data = await response.json();
                if (data.success) {
                    showToast('success', data.message);
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showToast('error', data.message);
                }
            } catch (error) {
                console.error('Error resending SMS:', error);
                showToast('error', 'Error resending SMS');
            }
        }

        function showToast(type, message) {
            const toastHtml = `
                <div class="toast align-items-center text-white bg-${type === 'success' ? 'success' : 'danger'} border-0 position-fixed bottom-0 end-0 m-3" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-triangle'} me-2"></i>
                            ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;
            $('body').append(toastHtml);
            const toast = $('.toast').last();
            const bsToast = new bootstrap.Toast(toast[0]);
            bsToast.show();
            toast.on('hidden.bs.toast', function() { $(this).remove(); });
        }
    </script>
}