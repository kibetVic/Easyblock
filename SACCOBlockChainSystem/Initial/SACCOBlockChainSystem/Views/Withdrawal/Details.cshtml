@model SACCOBlockChainSystem.Models.MemberWithdrawal
@{
    ViewData["Title"] = "Withdrawal Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary me-3">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                    <h2 class="page-title d-inline-block mb-0">
                        <i class="bi bi-person-x me-2"></i>Withdrawal Details
                    </h2>
                </div>
                <div>
                    @if (Model.Status == "Pending")
                    {
                        <button type="button" class="btn btn-success me-2" data-bs-toggle="modal" data-bs-target="#approveModal">
                            <i class="bi bi-check-circle me-1"></i> Approve
                        </button>
                        <button type="button" class="btn btn-danger me-2" data-bs-toggle="modal" data-bs-target="#rejectModal">
                            <i class="bi bi-x-circle me-1"></i> Reject
                        </button>
                        <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#cancelModal">
                            <i class="bi bi-ban me-1"></i> Cancel
                        </button>
                    }
                    @if (Model.Status == "Approved")
                    {
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#paymentModal">
                            <i class="bi bi-cash-stack me-1"></i> Process Payment
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Main Details -->
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-file-text me-2"></i>Withdrawal Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="text-muted">Withdrawal Number:</label>
                                <p class="fw-bold mb-0">@Model.WithdrawalNo</p>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted">Withdrawal Type:</label>
                                <p class="mb-0">@Model.WithdrawalType</p>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted">Withdrawal Date:</label>
                                <p class="mb-0">@Model.WithdrawalDate.ToString("dd/MM/yyyy")</p>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted">Status:</label>
                                <p class="mb-0">
                                    @if (Model.Status == "Pending")
                                    {
                                        <span class="badge bg-warning">Pending</span>
                                    }
                                    else if (Model.Status == "Approved")
                                    {
                                        <span class="badge bg-info">Approved</span>
                                    }
                                    else if (Model.Status == "Completed")
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }
                                    else if (Model.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger">Rejected</span>
                                    }
                                    else if (Model.Status == "Cancelled")
                                    {
                                        <span class="badge bg-secondary">Cancelled</span>
                                    }
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="text-muted">Member Number:</label>
                                <p class="fw-bold mb-0">@Model.MemberNo</p>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted">Member Name:</label>
                                <p class="mb-0">@Model.Member?.Surname @Model.Member?.OtherNames</p>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted">Phone:</label>
                                <p class="mb-0">@Model.Member?.PhoneNo</p>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted">Email:</label>
                                <p class="mb-0">@Model.Member?.Email</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Financial Details -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-calculator me-2"></i>Financial Breakdown
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Total Shares Value:</strong></td>
                                    <td class="text-end">KES @Model.TotalSharesValue.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td><strong>Total Deposits:</strong></td>
                                    <td class="text-end">KES @Model.TotalDeposits.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td><strong>Outstanding Loans:</strong></td>
                                    <td class="text-end text-danger">KES @Model.OutstandingLoans.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td><strong>Penalties/Deductions:</strong></td>
                                    <td class="text-end text-danger">KES @Model.PenaltiesAndDeductions.ToString("N2")</td>
                                </tr>
                                <tr class="border-top">
                                    <td><strong class="text-success">Net Payable Amount:</strong></td>
                                    <td class="text-end fw-bold text-success fs-5">KES @Model.NetPayableAmount.ToString("N2")</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment Details -->
            @if (!string.IsNullOrEmpty(Model.PaymentMethod))
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-credit-card me-2"></i>Payment Details
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="text-muted">Payment Method:</label>
                                    <p class="mb-0">@Model.PaymentMethod</p>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.BankName))
                                {
                                    <div class="mb-3">
                                        <label class="text-muted">Bank Name:</label>
                                        <p class="mb-0">@Model.BankName</p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="text-muted">Account Number:</label>
                                        <p class="mb-0">@Model.BankAccountNo</p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="text-muted">Account Name:</label>
                                        <p class="mb-0">@Model.AccountName</p>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Model.ChequeNo))
                                {
                                    <div class="mb-3">
                                        <label class="text-muted">Cheque Number:</label>
                                        <p class="mb-0">@Model.ChequeNo</p>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Model.MobileNo))
                                {
                                    <div class="mb-3">
                                        <label class="text-muted">Mobile Number:</label>
                                        <p class="mb-0">@Model.MobileNo</p>
                                    </div>
                                }
                            </div>
                            @if (Model.PaymentDate.HasValue)
                            {
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="text-muted">Payment Date:</label>
                                        <p class="mb-0">@Model.PaymentDate?.ToString("dd/MM/yyyy")</p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="text-muted">Payment Reference:</label>
                                        <p class="mb-0">@Model.PaymentReference</p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="text-muted">Processed By:</label>
                                        <p class="mb-0">@Model.ProcessedBy</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Approval History -->
            @if (Model.Approvals.Any())
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-check2-circle me-2"></i>Approval History
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Level</th>
                                        <th>Status</th>
                                        <th>Approved By</th>
                                        <th>Date</th>
                                        <th>Comments</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var approval in Model.Approvals.OrderBy(a => a.ApprovalDate))
                                    {
                                        <tr>
                                            <td>@approval.ApprovalLevel</td>
                                            <td>
                                                @if (approval.ApprovalStatus == "Approved")
                                                {
                                                    <span class="badge bg-success">Approved</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Rejected</span>
                                                }
                                            </td>
                                            <td>@approval.ApprovedBy</td>
                                            <td>@approval.ApprovalDate?.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@approval.Comments</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- Remarks -->
            @if (!string.IsNullOrEmpty(Model.Remarks))
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-chat-text me-2"></i>Remarks
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-0">@Model.Remarks</p>
                    </div>
                </div>
            }

            <!-- Blockchain Information -->
            @if (!string.IsNullOrEmpty(Model.BlockchainTxId))
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-link-45deg me-2"></i>Blockchain Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <label class="text-muted">Transaction ID:</label>
                            <p class="mb-0"><code>@Model.BlockchainTxId</code></p>
                        </div>
                        <div class="mb-2">
                            <label class="text-muted">Created At:</label>
                            <p class="mb-0">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Timeline -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-clock-history me-2"></i>Timeline
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <i class="bi bi-plus-circle text-primary me-2"></i>
                            <strong>Created:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            <br />
                            <small class="text-muted">By: @Model.CreatedBy</small>
                        </li>
                        @if (Model.ApprovalDate.HasValue)
                        {
                            <li class="list-group-item">
                                <i class="bi bi-check-circle text-success me-2"></i>
                                <strong>Approved:</strong> @Model.ApprovalDate?.ToString("dd/MM/yyyy HH:mm")
                                <br />
                                <small class="text-muted">By: @Model.ApprovedBy</small>
                            </li>
                        }
                        @if (Model.PaymentDate.HasValue)
                        {
                            <li class="list-group-item">
                                <i class="bi bi-cash-stack text-info me-2"></i>
                                <strong>Paid:</strong> @Model.PaymentDate?.ToString("dd/MM/yyyy HH:mm")
                                <br />
                                <small class="text-muted">By: @Model.ProcessedBy</small>
                            </li>
                        }
                        @if (Model.ModifiedAt.HasValue)
                        {
                            <li class="list-group-item">
                                <i class="bi bi-pencil-square text-warning me-2"></i>
                                <strong>Last Modified:</strong> @Model.ModifiedAt?.ToString("dd/MM/yyyy HH:mm")
                                <br />
                                <small class="text-muted">By: @Model.ModifiedBy</small>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Approve Modal -->
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Approve" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Approve Withdrawal</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Comments (Optional)</label>
                        <textarea name="comments" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        Net amount to be paid: <strong>KES @Model.NetPayableAmount.ToString("N2")</strong>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Confirm Approval</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Reject" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Reject Withdrawal</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Reason for Rejection *</label>
                        <textarea name="reason" class="form-control" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Cancel Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Cancel" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">Cancel Withdrawal</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Reason for Cancellation *</label>
                        <textarea name="reason" class="form-control" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Confirm Cancellation</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ProcessPayment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Process Payment</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Payment Date *</label>
                        <input type="date" name="paymentDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Payment Reference *</label>
                        <input type="text" name="paymentReference" class="form-control" placeholder="Transaction ID, Receipt No, etc." required />
                    </div>
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        Amount to pay: <strong>KES @Model.NetPayableAmount.ToString("N2")</strong>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Confirm Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}