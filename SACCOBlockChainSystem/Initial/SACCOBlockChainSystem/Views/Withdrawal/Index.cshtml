@model List<SACCOBlockChainSystem.Models.DTOs.WithdrawalResponseDTO>
@{
    ViewData["Title"] = "Member Withdrawals";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentStatus = ViewBag.CurrentStatus as string ?? "All";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <a asp-controller="MemberMvc" asp-action="Index" class="btn btn-outline-secondary me-3">
                        <i class="bi bi-arrow-left"></i> Back to Members
                    </a>
                    <h2 class="page-title d-inline-block mb-0">
                        <i class="bi bi-person-x me-2"></i>Member Withdrawals
                    </h2>
                </div>
                <div>
                    <a asp-controller="MemberMvc" asp-action="Search" class="btn btn-outline-primary me-2">
                        <i class="bi bi-search me-1"></i> Find Member
                    </a>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>New Withdrawal
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Filter -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="btn-group flex-wrap" role="group">
                <a asp-action="Index" asp-route-status="All" class="btn @(currentStatus == "All" ? "btn-primary" : "btn-outline-primary")">
                    All
                </a>
                <a asp-action="Index" asp-route-status="Pending" class="btn @(currentStatus == "Pending" ? "btn-warning" : "btn-outline-warning")">
                    <i class="bi bi-clock-history"></i> Pending
                </a>
                <a asp-action="Index" asp-route-status="Approved" class="btn @(currentStatus == "Approved" ? "btn-info" : "btn-outline-info")">
                    <i class="bi bi-check-circle"></i> Approved
                </a>
                <a asp-action="Index" asp-route-status="Completed" class="btn @(currentStatus == "Completed" ? "btn-success" : "btn-outline-success")">
                    <i class="bi bi-check2-circle"></i> Completed
                </a>
                <a asp-action="Index" asp-route-status="Rejected" class="btn @(currentStatus == "Rejected" ? "btn-danger" : "btn-outline-danger")">
                    <i class="bi bi-x-circle"></i> Rejected
                </a>
                <a asp-action="Index" asp-route-status="Cancelled" class="btn @(currentStatus == "Cancelled" ? "btn-secondary" : "btn-outline-secondary")">
                    <i class="bi bi-ban"></i> Cancelled
                </a>
            </div>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="card-title mb-0">
                <i class="bi bi-table me-2"></i>Withdrawal Requests
            </h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="withdrawalsTable">
                    <thead class="table-light">
                        <tr>
                            <th>Withdrawal No</th>
                            <th>Member No</th>
                            <th>Member Name</th>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Shares Value</th>
                            <th>Outstanding Loans</th>
                            <th>Net Payable</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var withdrawal in Model)
                            {
                                <tr>
                                    <td><strong>@withdrawal.WithdrawalNo</strong></td>
                                    <td>
                                        <a asp-controller="MemberMvc" asp-action="Details" asp-route-memberNo="@withdrawal.MemberNo" class="text-decoration-none">
                                            @withdrawal.MemberNo
                                        </a>
                                    </td>
                                    <td>@withdrawal.MemberName</td>
                                    <td>@withdrawal.WithdrawalDate.ToString("dd/MM/yyyy")</td>
                                    <td>@withdrawal.WithdrawalType</td>
                                    <td class="text-end">KES @withdrawal.TotalSharesValue.ToString("N2")</td>
                                    <td class="text-end text-danger">KES @withdrawal.OutstandingLoans.ToString("N2")</td>
                                    <td class="text-end fw-bold text-success">KES @withdrawal.NetPayableAmount.ToString("N2")</td>
                                    <td>
                                        @if (withdrawal.Status == "Pending")
                                        {
                                            <span class="badge bg-warning">Pending</span>
                                        }
                                        else if (withdrawal.Status == "Approved")
                                        {
                                            <span class="badge bg-info">Approved</span>
                                        }
                                        else if (withdrawal.Status == "Completed")
                                        {
                                            <span class="badge bg-success">Completed</span>
                                        }
                                        else if (withdrawal.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">Rejected</span>
                                        }
                                        else if (withdrawal.Status == "Cancelled")
                                        {
                                            <span class="badge bg-secondary">Cancelled</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@withdrawal.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (withdrawal.Status == "Pending")
                                            {
                                                <a asp-action="Edit" asp-route-id="@withdrawal.Id" class="btn btn-sm btn-outline-warning" title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            }
                                            @if (withdrawal.Status == "Completed")
                                            {
                                                <a asp-controller="MemberMvc" asp-action="Details" asp-route-memberNo="@withdrawal.MemberNo" class="btn btn-sm btn-outline-success" title="View Member">
                                                    <i class="bi bi-person"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted py-4">
                                    <i class="bi bi-info-circle me-2"></i>No withdrawal requests found
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#withdrawalsTable').DataTable({
                pageLength: 10,
                ordering: true,
                responsive: true,
                language: {
                    lengthMenu: "Show _MENU_ withdrawals per page",
                    info: "Showing _START_ to _END_ of _TOTAL_ withdrawals",
                    infoEmpty: "No withdrawals found",
                    zeroRecords: "No matching withdrawals found",
                    search: "Search:",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next",
                        previous: "Previous"
                    }
                },
                order: [[3, 'desc']] // Sort by date descending
            });
        });
    </script>
}