@model SACCOBlockChainSystem.Models.DTOs.MemberWithdrawalDTO
@{
    ViewData["Title"] = "New Withdrawal Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var member = ViewBag.Member as SACCOBlockChainSystem.Models.Member;
    var calculation = ViewBag.Calculation as SACCOBlockChainSystem.Models.DTOs.WithdrawalCalculationDTO;
    var memberNo = ViewBag.MemberNo as string;
    var memberName = ViewBag.MemberName as string;
    var noticeDays = ViewBag.NoticeDays as int? ?? 30;
    var hasMember = member != null;
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center">
                <a asp-action="Index" class="btn btn-outline-secondary me-3">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
                <h2 class="page-title mb-0">
                    <i class="bi bi-person-x me-2"></i>New Withdrawal Request
                </h2>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Member Search Section - Similar to ShareTransfer -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="card-title mb-0">
                <i class="bi bi-search me-2"></i>Search Member
            </h5>
        </div>
        <div class="card-body">
            <div class="row align-items-end">
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="fw-bold">Search By</label>
                        <select id="searchType" class="form-select">
                            <option value="memberNo">Member Number</option>
                            <option value="idNo">ID Number</option>
                            <option value="phoneNo">Phone Number</option>
                            <option value="fullName">Full Name</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="fw-bold" id="searchLabel">Member Number</label>
                        <div class="input-group">
                            <input type="text" id="searchValue" class="form-control"
                                   placeholder="Enter member number..." />
                            <button type="button" class="btn btn-primary" onclick="performSearch()">
                                <i class="bi bi-search"></i> Search
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>&nbsp;</label>
                        <button type="button" class="btn btn-outline-secondary w-100" onclick="clearSearch()">
                            <i class="bi bi-eraser"></i> Clear
                        </button>
                    </div>
                </div>
            </div>

            <!-- Search Results - Same pattern as ShareTransfer -->
            <div id="searchResults" class="mt-3" style="display: none;">
                <div class="alert alert-success">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <strong>Member Found:</strong>
                            <span id="memberInfo"></span>
                        </div>
                        <div class="col-md-4 text-end">
                            <button type="button" class="btn btn-sm btn-success" onclick="selectMember()">
                                <i class="bi bi-check-circle me-1"></i> Select This Member
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Selected Member Display - Same pattern as ShareTransfer -->
            <div id="selectedMemberInfo" class="mt-3" style="display: none;">
                <div class="alert alert-info">
                    <i class="bi bi-person-check-fill me-2"></i>
                    <strong>Selected Member:</strong>
                    <span id="selectedMemberName"></span>
                    <input type="hidden" id="selectedMemberNo" />
                </div>
            </div>
        </div>
    </div>

    @if (hasMember)
    {
        <div class="row">
            <!-- Left Column - Member Summary -->
            <div class="col-md-4">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-person-badge me-2"></i>Member Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="text-muted">Member Number:</label>
                            <p class="fw-bold mb-0">@memberNo</p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted">Full Name:</label>
                            <p class="fw-bold mb-0">@memberName</p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted">ID Number:</label>
                            <p class="mb-0">@member?.Idno</p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted">Phone:</label>
                            <p class="mb-0">@member?.PhoneNo</p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted">Email:</label>
                            <p class="mb-0">@member?.Email</p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted">Date Joined:</label>
                            <p class="mb-0">@(member?.ApplicDate?.ToString("dd/MM/yyyy") ?? "N/A")</p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted">Membership Type:</label>
                            <p class="mb-0">@(member?.MembershipType ?? "N/A")</p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted">Department:</label>
                            <p class="mb-0">@(member?.Dept ?? "N/A")</p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted">Station:</label>
                            <p class="mb-0">@(member?.Station ?? "N/A")</p>
                        </div>
                        @if (member?.ApplicDate.HasValue == true)
                        {
                            var membershipMonths = (DateTime.Now - member.ApplicDate.Value).TotalDays / 30;
                            var noticeDate = member.ApplicDate.Value.AddDays(noticeDays);
                            var isNoticeServed = DateTime.Now >= noticeDate;
                            <div class="alert @(isNoticeServed ? "alert-success" : "alert-warning") mt-2">
                                <i class="bi @(isNoticeServed ? "bi-check-circle" : "bi-clock-history") me-2"></i>
                                <small>
                                    <strong>Membership Duration:</strong> @Math.Floor(membershipMonths) months<br />
                                    <strong>Notice Period Ends:</strong> @noticeDate.ToString("dd/MM/yyyy")<br />
                                    <strong>Notice Status:</strong> @(isNoticeServed ? "Served ✓" : "Pending - " + (noticeDate - DateTime.Now).Days + " days remaining")
                                </small>
                            </div>
                        }
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-calculator me-2"></i>Withdrawal Calculation
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="text-muted">Total Shares Value:</label>
                            <p class="fw-bold mb-0 text-primary">KES @calculation?.TotalSharesValue.ToString("N2")</p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted">Total Deposits:</label>
                            <p class="fw-bold mb-0 text-primary">KES @calculation?.TotalDeposits.ToString("N2")</p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted text-danger">Outstanding Loans:</label>
                            <p class="fw-bold mb-0 text-danger">KES @calculation?.OutstandingLoans.ToString("N2")</p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted">Penalties/Deductions:</label>
                            <p class="fw-bold mb-0 text-danger">KES @calculation?.PenaltiesAndDeductions.ToString("N2")</p>
                        </div>
                        <hr />
                        <div class="mb-3">
                            <label class="fw-bold">Net Payable Amount:</label>
                            <p class="fw-bold mb-0 text-success fs-4">KES @calculation?.NetPayableAmount.ToString("N2")</p>
                        </div>
                        @if (!calculation.IsEligibleForWithdrawal)
                        {
                            <div class="alert alert-warning mt-3">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                @calculation.EligibilityMessage
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column - Withdrawal Form -->
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-pencil-square me-2"></i>Withdrawal Details
                        </h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="Create" method="post" id="withdrawalForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="memberNo" id="memberNoField" value="@memberNo" />

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display: none;"></div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="WithdrawalType" class="form-label fw-bold">Withdrawal Type *</label>
                                    <select asp-for="WithdrawalType" class="form-select" required>
                                        <option value="Voluntary">Voluntary</option>
                                        <option value="Retirement">Retirement</option>
                                        <option value="Transfer">Transfer to Another SACCO</option>
                                    </select>
                                    <span asp-validation-for="WithdrawalType" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="WithdrawalDate" class="form-label fw-bold">Withdrawal Date *</label>
                                    <input asp-for="WithdrawalDate" type="date" class="form-control" required
                                           min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                    <span asp-validation-for="WithdrawalDate" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label asp-for="PaymentMethod" class="form-label fw-bold">Payment Method</label>
                                    <select asp-for="PaymentMethod" class="form-select" id="paymentMethod">
                                        <option value="">-- Select Payment Method --</option>
                                        <option value="Bank Transfer">Bank Transfer</option>
                                        <option value="Cheque">Cheque</option>
                                        <option value="Cash">Cash</option>
                                        <option value="Mobile Money">Mobile Money</option>
                                    </select>
                                    <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Bank Transfer Details -->
                            <div id="bankDetails" style="display: none;">
                                <div class="card bg-light mb-3">
                                    <div class="card-header">
                                        <i class="bi bi-building me-2"></i>Bank Transfer Details
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label asp-for="BankName" class="form-label">Bank Name</label>
                                                <input asp-for="BankName" class="form-control" />
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label asp-for="BankAccountNo" class="form-label">Account Number</label>
                                                <input asp-for="BankAccountNo" class="form-control" />
                                            </div>
                                            <div class="col-md-12 mb-3">
                                                <label asp-for="AccountName" class="form-label">Account Name</label>
                                                <input asp-for="AccountName" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Cheque Details -->
                            <div id="chequeDetails" style="display: none;">
                                <div class="card bg-light mb-3">
                                    <div class="card-header">
                                        <i class="bi bi-journal me-2"></i>Cheque Details
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-12 mb-3">
                                                <label asp-for="ChequeNo" class="form-label">Cheque Number</label>
                                                <input asp-for="ChequeNo" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Mobile Money Details -->
                            <div id="mobileDetails" style="display: none;">
                                <div class="card bg-light mb-3">
                                    <div class="card-header">
                                        <i class="bi bi-phone me-2"></i>Mobile Money Details
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-12 mb-3">
                                                <label asp-for="MobileNo" class="form-label">Mobile Number</label>
                                                <input asp-for="MobileNo" class="form-control" placeholder="0712345678" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label asp-for="Remarks" class="form-label">Remarks</label>
                                    <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Any additional information..."></textarea>
                                    <span asp-validation-for="Remarks" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label asp-for="DocumentPath" class="form-label">Supporting Document</label>
                                    <input asp-for="DocumentPath" class="form-control" placeholder="Path to uploaded document" />
                                    <small class="text-muted">Upload the withdrawal application letter or other supporting documents</small>
                                </div>
                            </div>

                            <div class="alert alert-warning mt-3">
                                <i class="bi bi-info-circle-fill me-2"></i>
                                <strong>Important Information:</strong>
                                <ul class="mb-0 mt-2">
                                    <li>Withdrawal requires <strong>@noticeDays days notice</strong> from the date of joining</li>
                                    <li>All outstanding loans must be cleared before withdrawal</li>
                                    <li>Processing may take up to 30 days after approval</li>
                                    <li>Withdrawal amount is subject to verification and approval</li>
                                    <li>Once processed, membership will be terminated</li>
                                </ul>
                            </div>

                            <hr />

                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="bi bi-x-circle me-1"></i> Cancel
                                </a>
                                <button type="submit" class="btn btn-primary" @(!calculation.IsEligibleForWithdrawal ? "disabled" : "") id="submitBtn">
                                    <i class="bi bi-send me-2"></i>Submit Withdrawal Request
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-search display-1 text-muted"></i>
                <h4 class="mt-3 text-muted">Search for a Member</h4>
                <p class="text-muted">Use the search above to find a member and start the withdrawal process</p>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let currentMemberData = null;

        $(document).ready(function() {
            // Update search label based on selection - Same as ShareTransfer
            $('#searchType').on('change', function() {
                const searchType = $(this).val();
                const searchLabel = $('#searchLabel');
                const searchInput = $('#searchValue');

                if (searchType === 'memberNo') {
                    searchLabel.text('Member Number');
                    searchInput.attr('placeholder', 'Enter member number...');
                } else if (searchType === 'idNo') {
                    searchLabel.text('ID Number');
                    searchInput.attr('placeholder', 'Enter ID number...');
                } else if (searchType === 'phoneNo') {
                    searchLabel.text('Phone Number');
                    searchInput.attr('placeholder', 'Enter phone number...');
                } else {
                    searchLabel.text('Full Name');
                    searchInput.attr('placeholder', 'Enter full name...');
                }
                searchInput.val('');
                $('#searchResults').hide();
            });

            // Payment method toggle
            $('#paymentMethod').on('change', function() {
                var method = $(this).val();
                $('#bankDetails, #chequeDetails, #mobileDetails').hide();

                if (method === 'Bank Transfer') {
                    $('#bankDetails').show();
                } else if (method === 'Cheque') {
                    $('#chequeDetails').show();
                } else if (method === 'Mobile Money') {
                    $('#mobileDetails').show();
                }
            });

            // Form submission with loading state
            $('#withdrawalForm').on('submit', function() {
                var submitBtn = $('#submitBtn');
                submitBtn.prop('disabled', true);
                submitBtn.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Submitting...');
                return true;
            });

            // Withdrawal date validation
            var today = new Date().toISOString().split('T')[0];
            $('#WithdrawalDate').attr('min', today);

            // Allow Enter key to search - Same as ShareTransfer
            $('#searchValue').on('keypress', function(e) {
                if (e.key === 'Enter') {
                    performSearch();
                }
            });
        });

        // Search function - Same pattern as ShareTransfer
        async function performSearch() {
            const searchType = $('#searchType').val();
            const searchValue = $('#searchValue').val().trim();

            if (!searchValue) {
                alert('Please enter a ' + $('#searchLabel').text());
                return;
            }

            let url = '';
            let params = {};

            if (searchType === 'memberNo') {
                url = '/MemberMvc/SearchMember';
                params = { memberNo: searchValue };
            } else if (searchType === 'idNo') {
                url = '/MemberMvc/SearchMember';
                params = { idNo: searchValue };
            } else if (searchType === 'phoneNo') {
                url = '/MemberMvc/SearchMember';
                params = { phoneNo: searchValue };
            } else {
                url = '/MemberMvc/SearchMember';
                params = { fullName: searchValue };
            }

            const queryString = new URLSearchParams(params).toString();
            url = `${url}?${queryString}`;

            try {
                const response = await fetch(url);
                const data = await response.json();

                if (data.success && data.member) {
                    currentMemberData = data.member;
                    $('#memberInfo').html(`
                        <strong>${data.member.memberNo}</strong> - ${data.member.fullName}<br/>
                        <small>ID: ${data.member.idNo || 'N/A'} | Phone: ${data.member.phoneNo || 'N/A'}</small>
                    `);
                    $('#searchResults').show();
                    $('#selectedMemberInfo').hide();
                } else {
                    alert(data.message || 'Member not found');
                    $('#searchResults').hide();
                }
            } catch (error) {
                console.error('Error searching member:', error);
                alert('Error searching for member. Please try again.');
            }
        }

        // Select member function - Same as ShareTransfer
        function selectMember() {
            if (currentMemberData) {
                // Redirect to create with selected member
                window.location.href = `/Withdrawal/Create?memberNo=${currentMemberData.memberNo}`;
            }
        }

        // Clear search function - Same as ShareTransfer
        function clearSearch() {
            $('#searchType').val('memberNo');
            $('#searchValue').val('');
            $('#searchLabel').text('Member Number');
            $('#searchValue').attr('placeholder', 'Enter member number...');
            $('#searchResults').hide();
            $('#selectedMemberInfo').hide();
            currentMemberData = null;

            // Redirect back to empty create page
            window.location.href = '/Withdrawal/Create';
        }
    </script>
}