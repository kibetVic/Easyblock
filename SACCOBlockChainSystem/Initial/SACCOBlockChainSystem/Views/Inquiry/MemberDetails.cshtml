@model SACCOBlockChainSystem.Models.DTOs.MemberInquiryResponseDTO

@{
    ViewData["Title"] = $"Member Details - {Model.MemberNo}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="bi bi-person-badge"></i> Member Information
        </h3>
        <div class="card-tools">
            <a href="@Url.Action("MemberInquiry")" class="btn btn-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Search
            </a>
            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                <i class="bi bi-dash"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        <!-- Personal Information -->
        <div class="row">
            <div class="col-md-6">
                <div class="info-box bg-light">
                    <div class="info-box-content">
                        <span class="info-box-text text-center text-muted">Personal Details</span>
                        <hr />
                        <div class="row">
                            <div class="col-6"><strong>Member No:</strong></div>
                            <div class="col-6">@Model.MemberNo</div>

                            <div class="col-6"><strong>Full Name:</strong></div>
                            <div class="col-6">@Model.FullName</div>

                            <div class="col-6"><strong>ID Number:</strong></div>
                            <div class="col-6">@Model.IdNo</div>

                            <div class="col-6"><strong>Phone:</strong></div>
                            <div class="col-6">@Model.PhoneNo</div>

                            <div class="col-6"><strong>Email:</strong></div>
                            <div class="col-6">@Model.Email</div>

                            <div class="col-6"><strong>Gender:</strong></div>
                            <div class="col-6">@Model.Gender</div>

                            <div class="col-6"><strong>Date of Birth:</strong></div>
                            <div class="col-6">@(Model.DateOfBirth?.ToString("dd-MMM-yyyy") ?? "N/A")</div>

                            <div class="col-6"><strong>Age:</strong></div>
                            <div class="col-6">@Model.Age</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box bg-light">
                    <div class="info-box-content">
                        <span class="info-box-text text-center text-muted">Membership Details</span>
                        <hr />
                        <div class="row">
                            <div class="col-6"><strong>Membership Type:</strong></div>
                            <div class="col-6">@Model.MembershipType</div>

                            <div class="col-6"><strong>Registration Type:</strong></div>
                            <div class="col-6">@Model.RegistrationType</div>

                            <div class="col-6"><strong>Date Joined:</strong></div>
                            <div class="col-6">@(Model.DateJoined?.ToString("dd-MMM-yyyy") ?? "N/A")</div>

                            <div class="col-6"><strong>Status:</strong></div>
                            <div class="col-6">
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </div>

                            <div class="col-6"><strong>Employer:</strong></div>
                            <div class="col-6">@Model.Employer</div>

                            <div class="col-6"><strong>Department:</strong></div>
                            <div class="col-6">@Model.Department</div>

                            <div class="col-6"><strong>Station/County:</strong></div>
                            <div class="col-6">@Model.Station</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Financial Summary -->
        <div class="row mt-3">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title">Financial Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="small-box bg-info">
                                    <div class="inner">
                                        <h3>@Model.TotalContributions.ToString("N2")</h3>
                                        <p>Total Contributions</p>
                                    </div>
                                    <div class="icon">
                                        <i class="bi bi-cash"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="small-box bg-warning">
                                    <div class="inner">
                                        <h3>@Model.TotalLoanBalance.ToString("N2")</h3>
                                        <p>Total Loan Balance</p>
                                    </div>
                                    <div class="icon">
                                        <i class="bi bi-currency-dollar"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="small-box bg-danger">
                                    <div class="inner">
                                        <h3>@Model.ActiveLoansCount</h3>
                                        <p>Active Loans</p>
                                    </div>
                                    <div class="icon">
                                        <i class="bi bi-files"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="small-box bg-secondary">
                                    <div class="inner">
                                        <h3>@Model.TotalTransactions</h3>
                                        <p>Total Transactions</p>
                                    </div>
                                    <div class="icon">
                                        <i class="bi bi-receipt"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Share Balances -->
        @if (Model.ShareBalances.Any())
        {
            <div class="row mt-3">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title">Share Balances by Type</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Share Code</th>
                                            <th>Share Type</th>
                                            <th>Balance</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var share in Model.ShareBalances)
                                        {
                                            <tr>
                                                <td>@share.SharesCode</td>
                                                <td>@share.SharesType</td>
                                                <td class="text-end">@share.Balance.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="bg-light">
                                            <th colspan="2" class="text-end">Total:</th>
                                            <th class="text-end">@Model.ShareBalances.Sum(s => s.Balance).ToString("N2")</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Next of Keen -->
        @if (Model.NextOfKeens.Any())
        {
            <div class="row mt-3">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title">Next of Keen</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Full Name</th>
                                            <th>Relationship</th>
                                            <th>Phone</th>
                                            <th>Primary</th>
                                            <th>Benefit %</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var nok in Model.NextOfKeens)
                                        {
                                            <tr>
                                                <td>@nok.FullName</td>
                                                <td>@nok.Relationship</td>
                                                <td>@nok.PhoneNo</td>
                                                <td>
                                                    @if (nok.IsPrimary)
                                                    {
                                                        <span class="badge bg-success">Yes</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">No</span>
                                                    }
                                                </td>
                                                <td>@nok.BenefitPercentage%</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Quick Actions -->
        <div class="row mt-3">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title">Quick Actions</h5>
                    </div>
                    <div class="card-body text-center">
                        <a href="@Url.Action("ShareInquiry", new { memberNo = Model.MemberNo })" class="btn btn-success m-1">
                            <i class="bi bi-pie-chart"></i> View Share Details
                        </a>
                        <a href="@Url.Action("LoanInquiry", new { memberNo = Model.MemberNo })" class="btn btn-warning m-1">
                            <i class="bi bi-cash-stack"></i> View Loan Details
                        </a>
                        <a href="@Url.Action("TransactionInquiry", new { memberNo = Model.MemberNo })" class="btn btn-secondary m-1">
                            <i class="bi bi-receipt"></i> View Transaction History
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>