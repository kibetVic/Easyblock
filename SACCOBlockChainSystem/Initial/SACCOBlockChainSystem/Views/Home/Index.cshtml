<!-- Charts Row -->
<div class="row g-4">
    <!-- Transaction Statistics Chart -->
    <div class="col-lg-5 col-xl-8 mb-4">
        <div class="card shadow border-0 rounded-3 h-100">
            <div class="card-header bg-white py-3 d-flex flex-row align-items-center justify-content-between border-0">
                <h6 class="m-0 fw-bold text-primary">Monthly Transaction Statistics</h6>
                <div class="dropdown no-arrow">
                    <a class="dropdown-toggle" href="#" role="button" id="dropdownMenuLink"
                       data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <i class="fas fa-ellipsis-v fa-sm fa-fw text-gray-400"></i>
                    </a>
                    <div class="dropdown-menu dropdown-menu-right shadow animated--fade-in">
                        <a class="dropdown-item" href="#" onclick="updateChart('6m')">Last 6 Months</a>
                        <a class="dropdown-item" href="#" onclick="updateChart('1y')">Last 1 Year</a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item" href="/Reports/Financial">View Detailed Report</a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="chart-area" style="position: relative; height: 280px; width: 100%;">
                    <canvas id="transactionChart" style="width: 100%; height: 100%;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Member Growth Chart -->
    <div class="col-lg-5 col-xl-4 mb-4">
        <div class="card shadow border-0 rounded-3 h-100">
            <div class="card-header bg-white py-3 border-0">
                <h6 class="m-0 fw-bold text-primary">Member Growth</h6>
            </div>
            <div class="card-body">
                <div class="chart-pie" style="position: relative; height: 280px; width: 100%;">
                    <canvas id="memberGrowthChart" style="width: 100%; height: 100%;"></canvas>
                </div>
                <div class="mt-4 text-center small">
                    <span class="me-3">
                        <i class="fas fa-circle text-success"></i> New Members
                    </span>
                    <span>
                        <i class="fas fa-circle text-primary"></i> Total Members
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let transactionChart, memberGrowthChart;
        let currentChartRange = '6m';

        $(document).ready(function() {
            loadChartData();
            setInterval(refreshDashboardStats, 30000);

            // Redraw charts on window resize
            $(window).on('resize', function() {
                if (transactionChart) {
                    transactionChart.resize();
                }
                if (memberGrowthChart) {
                    memberGrowthChart.resize();
                }
            });
        });

        function loadChartData() {
            // Get current company filter if any
            var companyCode = $('#companyFilter').val() || null;

            $.ajax({
                url: '/Home/GetChartData',
                type: 'GET',
                data: {
                    range: currentChartRange,
                    companyCode: companyCode
                },
                success: function(response) {
                    if (response.success) {
                        initTransactionChart(response.monthlyTransactions);
                        initMemberGrowthChart(response.memberGrowth);
                    } else {
                        console.error('Error loading chart data:', response.message);
                        showChartError();
                    }
                },
                error: function(xhr, status, error) {
                    console.error('AJAX Error:', error);
                    showChartError();
                }
            });
        }

        function showChartError() {
            $('#transactionChart').closest('.chart-area').html(
                '<div class="text-center py-5">' +
                '<i class="fas fa-chart-line fa-3x text-muted mb-3"></i>' +
                '<h5 class="text-muted">No Transaction Data Available</h5>' +
                '<p class="text-muted small">Please check back later or contact support</p>' +
                '</div>'
            );
            $('#memberGrowthChart').closest('.chart-pie').html(
                '<div class="text-center py-5">' +
                '<i class="fas fa-users fa-3x text-muted mb-3"></i>' +
                '<h5 class="text-muted">No Member Growth Data</h5>' +
                '</div>'
            );
        }

        function initTransactionChart(monthlyTransactions) {
            const ctx = document.getElementById('transactionChart').getContext('2d');

            if (!monthlyTransactions || monthlyTransactions.length === 0) {
                showChartError();
                return;
            }

            const months = monthlyTransactions.map(m => m.month);
            const deposits = monthlyTransactions.map(m => m.deposits);
            const withdrawals = monthlyTransactions.map(m => m.withdrawals);
            const repayments = monthlyTransactions.map(m => m.loanRepayments);

            // Destroy existing chart if it exists
            if (transactionChart) {
                transactionChart.destroy();
            }

            transactionChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: months,
                    datasets: [
                        {
                            label: 'Deposits',
                            data: deposits,
                            borderColor: '#2ecc71',
                            backgroundColor: 'rgba(46, 204, 113, 0.1)',
                            borderWidth: 2,
                            fill: true,
                            tension: 0.4,
                            pointBackgroundColor: '#2ecc71',
                            pointBorderColor: '#fff',
                            pointRadius: 4,
                            pointHoverRadius: 6
                        },
                        {
                            label: 'Withdrawals',
                            data: withdrawals,
                            borderColor: '#e74c3c',
                            backgroundColor: 'rgba(231, 76, 60, 0.1)',
                            borderWidth: 2,
                            fill: true,
                            tension: 0.4,
                            pointBackgroundColor: '#e74c3c',
                            pointBorderColor: '#fff',
                            pointRadius: 4,
                            pointHoverRadius: 6
                        },
                        {
                            label: 'Loan Repayments',
                            data: repayments,
                            borderColor: '#3498db',
                            backgroundColor: 'rgba(52, 152, 219, 0.1)',
                            borderWidth: 2,
                            fill: true,
                            tension: 0.4,
                            pointBackgroundColor: '#3498db',
                            pointBorderColor: '#fff',
                            pointRadius: 4,
                            pointHoverRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                boxWidth: 12,
                                usePointStyle: true,
                                font: { size: 11 }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    let value = context.raw;
                                    return `${label}: KES ${value.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return 'KES ' + value.toLocaleString();
                                },
                                font: { size: 10 }
                            },
                            grid: { color: 'rgba(0,0,0,0.05)' }
                        },
                        x: {
                            ticks: {
                                font: { size: 10 },
                                maxRotation: 45,
                                minRotation: 45
                            },
                            grid: { display: false }
                        }
                    },
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    hover: {
                        mode: 'nearest',
                        intersect: true
                    }
                }
            });
        }

        function initMemberGrowthChart(memberGrowth) {
            const ctx = document.getElementById('memberGrowthChart').getContext('2d');

            if (!memberGrowth || memberGrowth.length === 0) {
                $('#memberGrowthChart').closest('.chart-pie').html(
                    '<div class="text-center py-5">' +
                    '<i class="fas fa-users fa-3x text-muted mb-3"></i>' +
                    '<h5 class="text-muted">No Member Growth Data</h5>' +
                    '</div>'
                );
                return;
            }

            const periods = memberGrowth.map(m => m.period);
            const newMembers = memberGrowth.map(m => m.newMembers);
            const totalMembers = memberGrowth.map(m => m.totalMembers);

            // Destroy existing chart if it exists
            if (memberGrowthChart) {
                memberGrowthChart.destroy();
            }

            memberGrowthChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: periods,
                    datasets: [
                        {
                            label: 'New Members',
                            data: newMembers,
                            backgroundColor: '#2ecc71',
                            borderRadius: 4,
                            barPercentage: 0.7,
                            categoryPercentage: 0.8
                        },
                        {
                            label: 'Total Members',
                            data: totalMembers,
                            type: 'line',
                            borderColor: '#3498db',
                            borderWidth: 3,
                            fill: false,
                            tension: 0.4,
                            pointBackgroundColor: '#3498db',
                            pointBorderColor: '#fff',
                            pointRadius: 4,
                            pointHoverRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                boxWidth: 12,
                                usePointStyle: true,
                                font: { size: 11 }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    let value = context.raw;
                                    return `${label}: ${value.toLocaleString()}`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                font: { size: 10 },
                                callback: function(value) {
                                    return value.toLocaleString();
                                }
                            },
                            grid: { color: 'rgba(0,0,0,0.05)' }
                        },
                        x: {
                            ticks: {
                                font: { size: 10 },
                                maxRotation: 45,
                                minRotation: 45
                            },
                            grid: { display: false }
                        }
                    }
                }
            });
        }

        function updateChart(range) {
            currentChartRange = range;
            loadChartData();
        }

        function refreshDashboardStats() {
            var companyCode = $('#companyFilter').val() || null;

            $.ajax({
                url: '/Home/GetDashboardStats',
                type: 'GET',
                data: { companyCode: companyCode },
                success: function(response) {
                    if (response.success) {
                        // Update any live stats if needed
                        console.log('Dashboard stats refreshed:', response.data);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error refreshing stats:', error);
                }
            });
        }

        // If you have a company filter dropdown, add this event handler
        $(document).on('change', '#companyFilter', function() {
            loadChartData();
        });
    </script>
}