                        $('#formTitle').html('<i class="bi bi-pencil-square me-2"></i>Edit GIG');
                        $('#submitBtn').html('<i class="bi bi-save me-2"></i>Update GIG');

                        // Scroll to form
                        $('#gigFormCard')[0].scrollIntoView({ behavior: 'smooth' });
                    } else {
                        showToast('error', response.message);
                    }
                },
                error: function() {
                    showToast('error', 'Error loading GIG details');
                }
            });
        }

        function viewDetails(id) {
            $.ajax({
                url: '@Url.Action("GetGIGDetails", "GIGs")',
                type: 'GET',
                data: { id: id },
                success: function(response) {
                    if (response.success) {
                        var gig = response.gig;
                        $('#view_GigCode').text(gig.gigCode);
                        $('#view_GigName').text(gig.gigName);
                        $('#view_Company').text(gig.companyName + ' (' + gig.companyCode + ')');
                        $('#view_Chairperson').text(gig.chairperson || '-');
                        $('#view_ContactPhone').text(gig.contactPhone || '-');
                        $('#view_ContactEmail').text(gig.contactEmail || '-');
                        $('#view_RegistrationDate').text(gig.registrationDate ? new Date(gig.registrationDate).toLocaleDateString() : '-');
                        $('#view_TotalMembers').text(gig.totalMembers || '0');
                        $('#view_Status').html('<span class="badge bg-' + (gig.status === 'Active' ? 'success' : gig.status === 'Inactive' ? 'secondary' : gig.status === 'Pending' ? 'warning' : 'danger') + '">' + gig.status + '</span>');
                        $('#view_BlockchainTxId').text(gig.blockchainTxId || 'Not recorded');

                        $('#viewGIGModal').modal('show');
                    } else {
                        showToast('error', response.message);
                    }
                },
                error: function() {
                    showToast('error', 'Error loading GIG details');
                }
            });
        }

        function deleteGIG(id, gigName) {
            if (confirm(`Are you sure you want to delete GIG '${gigName}'? This action cannot be undone.`)) {
                $.ajax({
                    url: '@Url.Action("Delete", "GIGs")',
                    type: 'POST',
                    data: { id: id },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            showToast('success', response.message);
                            setTimeout(function() {
                                location.reload();
                            }, 1000);
                        } else {
                            showToast('error', response.message);
                        }
                    },
                    error: function() {
                        showToast('error', 'An error occurred. Please try again.');
                    }
                });
            }
        }

        function showToast(type, message) {
            var toastHtml = `
                <div class="toast align-items-center text-white bg-${type === 'success' ? 'success' : 'danger'} border-0 position-fixed bottom-0 end-0 m-3" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-triangle'} me-2"></i>
                            ${message.replace(/\n/g, '<br>')}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;

            $('body').append(toastHtml);
            var toast = $('.toast').last();
            var bsToast = new bootstrap.Toast(toast[0]);
            bsToast.show();

            toast.on('hidden.bs.toast', function() {
                $(this).remove();
            });
        }
    </script>
} *@